/// `CM_notAxi9`: admissible inverted range `(conf_lo = 2, conf_hi = 1)` has no witness `x`.
public pure fn is_cm_not_axi9(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
