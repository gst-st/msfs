}

/// `CM_notT2fStarStar`: permits `comp_md_bound = 5 >= obj_modal_cap = 1` while keeping `comp_dp_bound = 0 < obj_depth = 1`.
public pure fn is_cm_not_t2f_star_star(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.m_0 == 1 && s.m_1 == 1
