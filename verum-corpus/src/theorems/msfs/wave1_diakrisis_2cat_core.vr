/// Parameterized finite 2-categorical signature for the 13 Diakrisis interface
/// conditions (`Axi-0..Axi-9`, `T-alpha`, `T-2f*`, `T-2f**`), with zero bare
/// Bool flags and explicit 2-cell / realization / orbit / stratification fields.
public type DiakrisisFiniteSig is {
    ob_count: Int,
    z2_zero: Int,
    z2_one: Int,
    iota_0: Int,
    iota_1: Int,
    iota_z2_0: Int,
    iota_z2_1: Int,
    id_shift_0: Int,
    id_shift_1: Int,
    m_0: Int,
    m_1: Int,
    anchor: Int,
    act_00: Int,
    act_01: Int,
    eval_rho_0_on_0: Int,
    eval_rho_0_on_1: Int,
    rho_0: Int,
    rho_1: Int,
    rho_m0: Int,
    rho_m1: Int,
    eval_rho_iota_m_on_rho0: Int,
    eval_rho_iota_m_on_rho1: Int,
    iota_rho_m0: Int,
    iota_rho_m1: Int,
    iter_m_0: Int,
    iter_m_1: Int,
    iter_m_2: Int,
    orbit_cap: Int,
    conf_lo: Int,
    conf_hi: Int,
    gamma: Int,
    lens_slack: Int,
    comp_dp_bound: Int,
    comp_md_bound: Int,
    obj_depth: Int,
    obj_modal_cap: Int,
};

public pure fn has_base_nonthin_shift_fields(s: DiakrisisFiniteSig) -> Bool {
    s.ob_count >= 2
        && s.z2_zero == 0 && s.z2_one == 1
        && s.iota_0 == 0 && s.iota_1 == 1
        && s.id_shift_0 == 0 && s.id_shift_1 == 0
        && s.anchor == 0
        && s.obj_depth == 1 && s.obj_modal_cap == 1
}

public pure fn is_shift2cat_z2(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.m_0 == 1 && s.m_1 == 1
        && s.act_00 == 0 && s.act_01 == 1
        && s.eval_rho_0_on_0 == 0 && s.eval_rho_0_on_1 == 1
        && s.rho_0 == 0 && s.rho_1 == 1 && s.rho_m0 == 1 && s.rho_m1 == 2
        && s.eval_rho_iota_m_on_rho0 == 1 && s.eval_rho_iota_m_on_rho1 == 2
        && s.iota_rho_m0 == 1 && s.iota_rho_m1 == 2
        && s.iter_m_0 == 0 && s.iter_m_1 == 1 && s.iter_m_2 == 2 && s.orbit_cap == 1
        && s.conf_lo == 0 && s.conf_hi == 1
        && s.gamma == 1 && s.lens_slack == 0
        && s.comp_dp_bound == 0 && s.comp_md_bound == 0
}

/// `CM_notAxi1`: collapsing 2-functor `iota` maps both `z2_zero` and `z2_one` to `0`.
public pure fn is_cm_not_axi1(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 0
        && s.m_0 == 1 && s.m_1 == 1
        && s.act_00 == 0 && s.act_01 == 1
        && s.eval_rho_0_on_0 == 0 && s.eval_rho_0_on_1 == 1
        && s.rho_0 == 0 && s.rho_1 == 1 && s.rho_m0 == 1 && s.rho_m1 == 2
        && s.eval_rho_iota_m_on_rho0 == 1 && s.eval_rho_iota_m_on_rho1 == 2
        && s.iota_rho_m0 == 1 && s.iota_rho_m1 == 2
        && s.iter_m_0 == 0 && s.iter_m_1 == 1 && s.iter_m_2 == 2 && s.orbit_cap == 1
        && s.conf_lo == 0 && s.conf_hi == 1
        && s.gamma == 1 && s.lens_slack == 0
        && s.comp_dp_bound == 0 && s.comp_md_bound == 0
}

/// `CM_notAxi6`: genuine 2-rail `Nat x Fin 2` model (`rho(n, b) = (0, b)`, `M(n, b) = (n+1, b)`):
/// `rho_0 = 0 != 1 = rho_1` (`Axi-5` holds!), `eval(rho(iota(M)))(iota(rho(x))) = (0, b) = iota(rho(M(x)))`
/// (`Axi-7` holds!), and ONLY `Axi-6` fails (`rho_m0 == rho_0 && rho_m1 == rho_1`).
public pure fn is_cm_not_axi6(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.m_0 == 1 && s.m_1 == 1
        && s.act_00 == 0 && s.act_01 == 1
        && s.eval_rho_0_on_0 == 0 && s.eval_rho_0_on_1 == 1
        && s.rho_0 == 0 && s.rho_1 == 1 && s.rho_m0 == 0 && s.rho_m1 == 1
        && s.eval_rho_iota_m_on_rho0 == 0 && s.eval_rho_iota_m_on_rho1 == 1
        && s.iota_rho_m0 == 0 && s.iota_rho_m1 == 1
        && s.iter_m_0 == 0 && s.iter_m_1 == 1 && s.iter_m_2 == 2 && s.orbit_cap == 1
        && s.conf_lo == 0 && s.conf_hi == 1
        && s.gamma == 1 && s.lens_slack == 0
        && s.comp_dp_bound == 0 && s.comp_md_bound == 0
}

/// `CM_notAxi7`: shifted `rho(x) = x + 1` breaks equivariance `eval(rho(iota(M)))(iota(rho(0))) = 3 != 2 = iota(rho(M(0)))`.
public pure fn is_cm_not_axi7(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.m_0 == 1 && s.m_1 == 1
        && s.act_00 == 1 && s.act_01 == 2
        && s.eval_rho_0_on_0 == 1 && s.eval_rho_0_on_1 == 2
        && s.rho_0 == 1 && s.rho_1 == 2 && s.rho_m0 == 2 && s.rho_m1 == 3
        && s.eval_rho_iota_m_on_rho0 == 3 && s.eval_rho_iota_m_on_rho1 == 4
        && s.iota_rho_m0 == 2 && s.iota_rho_m1 == 3
        && s.iter_m_0 == 0 && s.iter_m_1 == 1 && s.iter_m_2 == 2 && s.orbit_cap == 1
        && s.conf_lo == 0 && s.conf_hi == 1
        && s.gamma == 1 && s.lens_slack == 0
        && s.comp_dp_bound == 0 && s.comp_md_bound == 0
}

/// `CM_notAxi8`: anchored shift `M(0) = 0, M(1) = 2` makes `K_M` representable at `anchor = 0`.
