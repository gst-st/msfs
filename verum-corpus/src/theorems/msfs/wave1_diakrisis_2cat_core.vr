/// `CM_notTAlpha`: universal lens visibility (`lens_slack = 1 >= gamma = 1`) leaves no blind spot.
public pure fn is_cm_not_t_alpha(s: DiakrisisFiniteSig) -> Bool {
    has_base_nonthin_shift_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.m_0 == 1 && s.m_1 == 1
