@framework(msfs, "MSFS Corollary 10.5 — conditional definitional conservativity (schematic stub; equiconsistency equation withdrawn)")
@delegate(msfs_corollary_10_5_conservativity_anchor)
public theorem msfs_corollary_10_5_conservativity(
