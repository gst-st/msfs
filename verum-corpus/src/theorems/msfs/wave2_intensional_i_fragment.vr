// =============================================================================
// STATUS: MACHINE-CHECKED WAVE 2 CONSTRUCTIVE CORE (ZERO AXIOMS)
// Self-contained finite constructive cores for MSFS Obligation B5 (`thm:I-fragment`,
// `T-233`, and `(I-4a)` variance / pullback / Beck-Chevalley obstructions):
//   1. `wave2_i_fragment_w2_separation`: `(W2)` non-invertible 2-cell in `SynInt`
//      vs all-invertible `SynExt` prevents any 2-equivalence.
//   2. `wave2_i_fragment_w1_canonical_inclusion`: `(W1)` canonical inclusion
//      equates distinct projections over `Gamma_Id`, failing local fullness.
//   3. `wave2_t233_strict_vs_isocomma`: `T-233(a)-(c)` non-isofibrant strict
//      pullback breaks equivalence (`0 != 1`) while iso-comma repairs it (`1 == 1`).
//   4. `wave2_i4a_diamond_no_right_adjoint`: `Diamond4 -> Diamond5` preserves
//      binary meets (strict 2-pullbacks) yet admits NO right adjoint.
//   5. `wave2_i4a_f_bang_breaks_pullback`: `f_! -| f^*` on `Set_{*,*} -> Set_*`
//      breaks pullbacks (`3 != 4`).
//   6. `wave2_i4a_strict_pb_bc_failure`: Sharp strict-pullback Beck-Chevalley
//      obstruction where all 4 functors preserve pullbacks & admit right adjoints,
//      yet `v_!(f_*(1)) = 0 < 1 = g_*(u_!(1))`.
// Imports zero `core.math.*` axioms and zero `: Bool` struct fields.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.2"),
    cve_closure_C: "self",
    cve_closure_V_strategy: VerifyStrategy.Formal,
    cve_closure_E: "tests/test_wave2_proofs.py",
)
module lib.theorems.msfs.wave2_intensional_i_fragment;

// =============================================================================
// Part 1: `thm:I-fragment` (`(W1)` and `(W2)`) on 4-morphism Hom(ctxId, ctxNat)
// =============================================================================

/// 4x4 Hom2-inhabitation matrix (`0` = empty, `1` = inhabited) on
/// `{0 = xProj, 1 = yProj, 2 = redex, 3 = nf}`. All fields strictly `Int`.
public type Display2CatFin4 is {
    h00: Int, h01: Int, h02: Int, h03: Int,
    h10: Int, h11: Int, h12: Int, h13: Int,
    h20: Int, h21: Int, h22: Int, h23: Int,
    h30: Int, h31: Int, h32: Int, h33: Int,
};

public pure fn hom2_at(c: Display2CatFin4, i: Int, j: Int) -> Int {
    if i == 0 {
        if j == 0 { c.h00 } else if j == 1 { c.h01 } else if j == 2 { c.h02 } else { c.h03 }
    } else if i == 1 {
        if j == 0 { c.h10 } else if j == 1 { c.h11 } else if j == 2 { c.h12 } else { c.h13 }
    } else if i == 2 {
        if j == 0 { c.h20 } else if j == 1 { c.h21 } else if j == 2 { c.h22 } else { c.h23 }
    } else {
        if j == 0 { c.h30 } else if j == 1 { c.h31 } else if j == 2 { c.h32 } else { c.h33 }
    }
}

public pure fn hom2_binary_at(c: Display2CatFin4, i: Int, j: Int) -> Bool {
    (hom2_at(c, i, j) == 0 || hom2_at(c, i, j) == 1)
}

public pure fn hom2_trans_triple(c: Display2CatFin4, i: Int, j: Int, k: Int) -> Bool {
    !(hom2_at(c, i, j) == 1 && hom2_at(c, j, k) == 1) || hom2_at(c, i, k) == 1
}

public pure fn hom2_trans_ij(c: Display2CatFin4, i: Int, j: Int) -> Bool {
    hom2_trans_triple(c, i, j, 0)
        && hom2_trans_triple(c, i, j, 1)
        && hom2_trans_triple(c, i, j, 2)
        && hom2_trans_triple(c, i, j, 3)
}

public pure fn valid_2cat_hom(c: Display2CatFin4) -> Bool {
    hom2_binary_at(c, 0, 0) && hom2_binary_at(c, 0, 1) && hom2_binary_at(c, 0, 2) && hom2_binary_at(c, 0, 3)
        && hom2_binary_at(c, 1, 0) && hom2_binary_at(c, 1, 1) && hom2_binary_at(c, 1, 2) && hom2_binary_at(c, 1, 3)
        && hom2_binary_at(c, 2, 0) && hom2_binary_at(c, 2, 1) && hom2_binary_at(c, 2, 2) && hom2_binary_at(c, 2, 3)
        && hom2_binary_at(c, 3, 0) && hom2_binary_at(c, 3, 1) && hom2_binary_at(c, 3, 2) && hom2_binary_at(c, 3, 3)
        && c.h00 == 1 && c.h11 == 1 && c.h22 == 1 && c.h33 == 1
        && hom2_trans_ij(c, 0, 0) && hom2_trans_ij(c, 0, 1) && hom2_trans_ij(c, 0, 2) && hom2_trans_ij(c, 0, 3)
        && hom2_trans_ij(c, 1, 0) && hom2_trans_ij(c, 1, 1) && hom2_trans_ij(c, 1, 2) && hom2_trans_ij(c, 1, 3)
        && hom2_trans_ij(c, 2, 0) && hom2_trans_ij(c, 2, 1) && hom2_trans_ij(c, 2, 2) && hom2_trans_ij(c, 2, 3)
        && hom2_trans_ij(c, 3, 0) && hom2_trans_ij(c, 3, 1) && hom2_trans_ij(c, 3, 2) && hom2_trans_ij(c, 3, 3)
}

public pure fn is_syn_int_2cat(c: Display2CatFin4) -> Bool {
    valid_2cat_hom(c)
        && c.h01 == 0 && c.h02 == 0 && c.h03 == 0
        && c.h10 == 0 && c.h12 == 0 && c.h13 == 0
        && c.h20 == 0 && c.h21 == 0 && c.h23 == 1
        && c.h30 == 0 && c.h31 == 0 && c.h32 == 0
}

public pure fn is_syn_ext_2cat(c: Display2CatFin4) -> Bool {
    valid_2cat_hom(c)
        && c.h01 == 1 && c.h02 == 1 && c.h03 == 1
        && c.h10 == 1 && c.h12 == 1 && c.h13 == 1
        && c.h20 == 1 && c.h21 == 1 && c.h23 == 1
        && c.h30 == 1 && c.h31 == 1 && c.h32 == 1
}

public pure fn is_invertible_2cell(c: Display2CatFin4, i: Int, j: Int) -> Bool {
    hom2_at(c, i, j) == 1 && hom2_at(c, j, i) == 1
}

public pure fn is_non_invertible_2cell(c: Display2CatFin4, i: Int, j: Int) -> Bool {
    hom2_at(c, i, j) == 1 && hom2_at(c, j, i) == 0
}

public pure fn sym_pair(c: Display2CatFin4, i: Int, j: Int) -> Bool {
    !(hom2_at(c, i, j) == 1) || hom2_at(c, j, i) == 1
}

public pure fn is_symmetric_hom2(c: Display2CatFin4) -> Bool {
    sym_pair(c, 0, 1) && sym_pair(c, 0, 2) && sym_pair(c, 0, 3)
        && sym_pair(c, 1, 0) && sym_pair(c, 1, 2) && sym_pair(c, 1, 3)
        && sym_pair(c, 2, 0) && sym_pair(c, 2, 1) && sym_pair(c, 2, 3)
        && sym_pair(c, 3, 0) && sym_pair(c, 3, 1) && sym_pair(c, 3, 2)
}

public type FunctorMap4 is {
    m0: Int,
    m1: Int,
    m2: Int,
    m3: Int,
};

public pure fn fmap4_at(phi: FunctorMap4, i: Int) -> Int {
    if i == 0 { phi.m0 } else if i == 1 { phi.m1 } else if i == 2 { phi.m2 } else { phi.m3 }
}

public pure fn is_valid_functor_map4(phi: FunctorMap4) -> Bool {
    phi.m0 >= 0 && phi.m0 <= 3
        && phi.m1 >= 0 && phi.m1 <= 3
        && phi.m2 >= 0 && phi.m2 <= 3
        && phi.m3 >= 0 && phi.m3 <= 3
}

public pure fn is_canonical_incl4(j: FunctorMap4) -> Bool {
    j.m0 == 0 && j.m1 == 1 && j.m2 == 2 && j.m3 == 3
}

public pure fn equivariant_pair(c1: Display2CatFin4, c2: Display2CatFin4, phi: FunctorMap4, i: Int, j: Int) -> Bool {
    (hom2_at(c1, i, j) == 1) == (hom2_at(c2, fmap4_at(phi, i), fmap4_at(phi, j)) == 1)
}

public pure fn preserves_and_reflects_2cells(c1: Display2CatFin4, c2: Display2CatFin4, phi: FunctorMap4) -> Bool {
    equivariant_pair(c1, c2, phi, 0, 1)
        && equivariant_pair(c1, c2, phi, 2, 3)
        && equivariant_pair(c1, c2, phi, 3, 2)
}

public pure fn is_locally_full_pair(c1: Display2CatFin4, c2: Display2CatFin4, phi: FunctorMap4, i: Int, j: Int) -> Bool {
    !(hom2_at(c2, fmap4_at(phi, i), fmap4_at(phi, j)) == 1) || hom2_at(c1, i, j) == 1
}

/// **MSFS Wave 2 (`thm:I-fragment` `(W2)`):**
/// `SynInt` has a strictly non-invertible 2-cell (`2 -> 3`, with `3 -> 2` empty),
/// whereas every 2-cell in `SynExt` is invertible; hence NO functor map `phi`
/// can induce a local equivalence of hom-categories.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B5 — (W2) 2-cell invertibility separates SynInt and SynExt")
public theorem wave2_i_fragment_w2_separation(
    c_int: Display2CatFin4,
    c_ext: Display2CatFin4,
    phi: FunctorMap4,
)
    requires is_syn_int_2cat(c_int)
          && is_syn_ext_2cat(c_ext)
          && is_valid_functor_map4(phi)
    ensures valid_2cat_hom(c_int)
         && valid_2cat_hom(c_ext)
         && is_non_invertible_2cell(c_int, 2, 3)
         && is_symmetric_hom2(c_ext)
         && !preserves_and_reflects_2cells(c_int, c_ext, phi)
    proof {
        have h_int: valid_2cat_hom(c_int) && is_non_invertible_2cell(c_int, 2, 3) by auto;
        have h_ext: valid_2cat_hom(c_ext) && is_symmetric_hom2(c_ext) by auto;
        have h_sep: !equivariant_pair(c_int, c_ext, phi, 3, 2) by auto;
        conclude by auto;
    };

/// **MSFS Wave 2 (`thm:I-fragment` `(W1)`):**
/// Under the canonical inclusion `j : T_int -> T_ext`, distinct projections
/// `0` and `1` over `Gamma_Id` have empty `Hom2` in `SynInt` yet invertible `Hom2`
/// in `SynExt`, falsifying local fullness on `(0, 1)`.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B5 — (W1) canonical inclusion fails local fullness on Gamma_Id")
public theorem wave2_i_fragment_w1_canonical_inclusion(
    c_int: Display2CatFin4,
    c_ext: Display2CatFin4,
    j: FunctorMap4,
)
    requires is_syn_int_2cat(c_int)
          && is_syn_ext_2cat(c_ext)
          && is_canonical_incl4(j)
    ensures hom2_at(c_int, 0, 1) == 0
         && hom2_at(c_ext, fmap4_at(j, 0), fmap4_at(j, 1)) == 1
         && is_invertible_2cell(c_ext, fmap4_at(j, 0), fmap4_at(j, 1))
         && !is_locally_full_pair(c_int, c_ext, j, 0, 1)
    proof {
        have h_empty: hom2_at(c_int, 0, 1) == 0 by auto;
        have h_inv: hom2_at(c_ext, fmap4_at(j, 0), fmap4_at(j, 1)) == 1
                 && is_invertible_2cell(c_ext, fmap4_at(j, 0), fmap4_at(j, 1)) by auto;
        conclude by auto;
    };

// =============================================================================
// Part 2: `T-233(a)-(c)` Strict vs Iso-Comma Pullback Dichotomy & Repair
// =============================================================================

/// 2-object skeletal/isomorphic base category `I = {0, 1}` with isomorphism
/// matrix `iso_ij in {0, 1}`. All fields strictly `Int`.
public type IsoCat2 is {
    iso_00: Int, iso_01: Int,
    iso_10: Int, iso_11: Int,
};

public pure fn iso_at2(c: IsoCat2, i: Int, j: Int) -> Int {
    if i == 0 {
        if j == 0 { c.iso_00 } else { c.iso_01 }
    } else {
        if j == 0 { c.iso_10 } else { c.iso_11 }
    }
}

public pure fn is_walking_iso2(c: IsoCat2) -> Bool {
    c.iso_00 == 1 && c.iso_01 == 1 && c.iso_10 == 1 && c.iso_11 == 1
}

/// Strict pullback object count of `* -> e0` and `* -> f1` into `I`.
public pure fn strict_pb_ob_count(e0_img: Int, f1_img: Int) -> Int {
    if e0_img == f1_img { 1 } else { 0 }
}

/// Iso-comma object count of `* -> e0` and `* -> f1` into `I`.
public pure fn iso_comma_ob_count(c: IsoCat2, e0_img: Int, f1_img: Int) -> Int {
    if iso_at2(c, e0_img, f1_img) == 1 { 1 } else { 0 }
}

/// Essential surjectivity onto the 1-object category `UnitCat` (`ob_count == 1`).
public pure fn is_ess_surj_to_unit(src_ob_count: Int) -> Bool {
    src_ob_count >= 1
}

/// **MSFS Wave 2 (`T-233(a)-(c)`):**
/// Pulling back `e0 : 1 -> I` (`* -> 0`, an equivalence) along non-isofibration
/// `f1 : 1 -> I` (`* -> 1`) produces an empty strict pullback (`0 != 1`, breaking
/// equivalence), whereas the iso-comma yields `1` object and repairs `e0` via
/// canonical comparison `c : EmptyCat -> IsoCommaCat`.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B5 — T-233 strict pullback failure vs iso-comma canonical repair")
public theorem wave2_t233_strict_vs_isocomma(
    cat_i: IsoCat2,
    e0_img: Int,
    f1_img: Int,
)
    requires is_walking_iso2(cat_i)
          && e0_img == 0
          && f1_img == 1
    ensures strict_pb_ob_count(e0_img, f1_img) == 0
         && !is_ess_surj_to_unit(strict_pb_ob_count(e0_img, f1_img))
         && iso_comma_ob_count(cat_i, e0_img, f1_img) == 1
         && is_ess_surj_to_unit(iso_comma_ob_count(cat_i, e0_img, f1_img))
         && strict_pb_ob_count(e0_img, f1_img) <= iso_comma_ob_count(cat_i, e0_img, f1_img)
    proof {
        have h_strict: strict_pb_ob_count(e0_img, f1_img) == 0
                    && !is_ess_surj_to_unit(strict_pb_ob_count(e0_img, f1_img)) by auto;
        have h_iso: iso_comma_ob_count(cat_i, e0_img, f1_img) == 1
                 && is_ess_surj_to_unit(iso_comma_ob_count(cat_i, e0_img, f1_img)) by auto;
        conclude by omega;
    };

// =============================================================================
// Part 3: `(I-4a)` Diamond4 -> Diamond5 No Right Adjoint
// =============================================================================

/// `Diamond4 = {0, 1, 2, 3}` with `0 < 1, 2 < 3`, `1 || 2`.
public pure fn le_d4(x: Int, y: Int) -> Bool {
    (x == 0 && y >= 0 && y <= 3)
        || (x == 1 && (y == 1 || y == 3))
        || (x == 2 && (y == 2 || y == 3))
        || (x == 3 && y == 3)
}

/// `Diamond5 = {0, 1, 2, 3, 4}` with `0 < 1, 2 < 3 < 4`, `1 || 2`.
public pure fn le_d5(x: Int, y: Int) -> Bool {
    (x == 0 && y >= 0 && y <= 4)
        || (x == 1 && (y == 1 || y == 3 || y == 4))
        || (x == 2 && (y == 2 || y == 3 || y == 4))
        || (x == 3 && (y == 3 || y == 4))
        || (x == 4 && y == 4)
}

public pure fn meet_d4(x: Int, y: Int) -> Int {
    if x == y { x }
    else if x == 3 { y }
    else if y == 3 { x }
    else { 0 }
}

public pure fn meet_d5(x: Int, y: Int) -> Int {
    if x == y { x }
    else if x == 4 { y }
    else if y == 4 { x }
    else if x == 3 { y }
    else if y == 3 { x }
    else { 0 }
}

public pure fn diamond_inc(x: Int) -> Int {
    if x == 0 { 0 } else if x == 1 { 1 } else if x == 2 { 2 } else { 4 }
}

public pure fn is_galois_at_3(r3: Int) -> Bool {
    (le_d5(diamond_inc(1), 3) == le_d4(1, r3))
        && (le_d5(diamond_inc(2), 3) == le_d4(2, r3))
        && (le_d5(diamond_inc(3), 3) == le_d4(3, r3))
}

/// **MSFS Wave 2 (`(I-4a)` Diamond Right-Adjoint Obstruction):**
/// `diamond_inc : Diamond4 -> Diamond5` preserves all binary meets (strict
/// 2-pullbacks), yet for every candidate `r3 in {0..3}` in `Diamond4`, the
/// Galois right-adjoint laws at `y = 3` (`1 <= r3 && 2 <= r3 => r3 == 3`,
/// conflicting with `4 <= 3`) fail.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B5 — (I-4a) Diamond4 -> Diamond5 preserves meets with no right adjoint")
public theorem wave2_i4a_diamond_no_right_adjoint(x: Int, y: Int, r3: Int)
    requires 0 <= x && x <= 3
          && 0 <= y && y <= 3
          && 0 <= r3 && r3 <= 3
    ensures diamond_inc(meet_d4(x, y)) == meet_d5(diamond_inc(x), diamond_inc(y))
         && !le_d5(diamond_inc(3), 3)
         && (!(le_d4(1, r3) && le_d4(2, r3)) || r3 == 3)
         && !is_galois_at_3(r3)
    proof {
        have h_meet: diamond_inc(meet_d4(x, y)) == meet_d5(diamond_inc(x), diamond_inc(y)) by auto;
        have h_join: (!(le_d4(1, r3) && le_d4(2, r3)) || r3 == 3) && !le_d5(diamond_inc(3), 3) by auto;
        conclude by auto;
    };

// =============================================================================
// Part 4: `(I-4a)` `f_!` Pullback Failure (`3 != 4`) & Strict-Pb BC Obstruction
// =============================================================================

public pure fn p_map(a: Int) -> Int {
    if a == 0 { 0 } else { 1 }
}

public pure fn q_map(b: Int) -> Int {
    if b == 2 { 1 } else { 0 }
}

public pure fn in_pb_pair(a: Int, b: Int) -> Int {
    if p_map(a) == q_map(b) { 1 } else { 0 }
}

public pure fn pb_total_card(x_c1: Int) -> Int {
    if x_c1 >= 0 {
        in_pb_pair(0, 0) + in_pb_pair(0, 1) + in_pb_pair(0, 2)
            + in_pb_pair(1, 0) + in_pb_pair(1, 1) + in_pb_pair(1, 2)
            + in_pb_pair(2, 0) + in_pb_pair(2, 1) + in_pb_pair(2, 2)
    } else { 0 }
}

public pure fn f_bang_quot_card(n: Int, c1: Int, c2: Int) -> Int {
    if c1 == c2 { n } else { n - 1 }
}

// Strict-pullback Beck-Chevalley witness:
// C1 = {0 < 1}, C2 = {0 < 1}, C3 = {0 < a < 1} encoded as {0 < 1 < 2}
public pure fn u_bang(x: Int) -> Int {
    if x == 0 { 0 } else { 2 }
}

public pure fn g_bang(x: Int) -> Int {
    if x == 0 { 0 } else { 1 }
}

public pure fn strict_pb_c1_c2_hit(x: Int, y: Int) -> Int {
    if u_bang(x) == g_bang(y) { 1 } else { 0 }
}

public pure fn strict_pb_c1_c2_size(base_root: Int) -> Int {
    if base_root == 0 {
        strict_pb_c1_c2_hit(0, 0) + strict_pb_c1_c2_hit(0, 1)
            + strict_pb_c1_c2_hit(1, 0) + strict_pb_c1_c2_hit(1, 1)
    } else { 0 }
}

public pure fn f_bang_pb(p: Int) -> Int { if p == 0 { 0 } else { 0 } }
public pure fn v_bang_pb(p: Int) -> Int { if p == 0 { 0 } else { 0 } }

public pure fn is_right_adj_u(u0: Int, u1: Int, u2: Int) -> Bool {
    (u0 >= 0 && u0 <= 1) && (u1 >= 0 && u1 <= 1) && (u2 >= 0 && u2 <= 1)
        && ((u_bang(0) <= 0) == (0 <= u0)) && ((u_bang(1) <= 0) == (1 <= u0))
        && ((u_bang(0) <= 1) == (0 <= u1)) && ((u_bang(1) <= 1) == (1 <= u1))
        && ((u_bang(0) <= 2) == (0 <= u2)) && ((u_bang(1) <= 2) == (1 <= u2))
}

public pure fn is_right_adj_g(g0: Int, g1: Int, g2: Int) -> Bool {
    (g0 >= 0 && g0 <= 1) && (g1 >= 0 && g1 <= 1) && (g2 >= 0 && g2 <= 1)
        && ((g_bang(0) <= 0) == (0 <= g0)) && ((g_bang(1) <= 0) == (1 <= g0))
        && ((g_bang(0) <= 1) == (0 <= g1)) && ((g_bang(1) <= 1) == (1 <= g1))
        && ((g_bang(0) <= 2) == (0 <= g2)) && ((g_bang(1) <= 2) == (1 <= g2))
}

public pure fn map3_at(v0: Int, v1: Int, v2: Int, z: Int) -> Int {
    if z == 0 { v0 } else if z == 1 { v1 } else { v2 }
}

/// **MSFS Wave 2 (`(I-4a)` `f_!` Pullback Failure on `Set_{*,*} -> Set_*`):**
/// For the pullback `P = X x_Z Y` (`|P| = 4` with distinct basepoints `(0,0) != (1,2)`),
/// `|f_!(P)| = 3 != 4 = |f_!(X) x_{f_!(Z)} f_!(Y)|`.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B5 — (I-4a) left adjoint f_! fails to preserve pullbacks (3 != 4)")
public theorem wave2_i4a_f_bang_breaks_pullback(
    x_c1: Int,
    x_c2: Int,
    y_c1: Int,
    y_c2: Int,
    z_c1: Int,
    z_c2: Int,
)
    requires x_c1 == 0 && x_c2 == 1
          && y_c1 == 0 && y_c2 == 2
          && z_c1 == 0 && z_c2 == 1
    ensures pb_total_card(x_c1) == 4
         && f_bang_quot_card(pb_total_card(x_c1), 0, 1) == 3
         && f_bang_quot_card(3, x_c1, x_c2) * f_bang_quot_card(3, y_c1, y_c2) == 4
         && f_bang_quot_card(2, z_c1, z_c2) == 1
         && f_bang_quot_card(pb_total_card(x_c1), 0, 1)
             != f_bang_quot_card(3, x_c1, x_c2) * f_bang_quot_card(3, y_c1, y_c2)
    proof {
        have h_pb: pb_total_card(x_c1) == 4 && f_bang_quot_card(pb_total_card(x_c1), 0, 1) == 3 by auto;
        have h_quot: f_bang_quot_card(3, x_c1, x_c2) * f_bang_quot_card(3, y_c1, y_c2) == 4
                  && f_bang_quot_card(2, z_c1, z_c2) == 1 by auto;
        conclude by auto;
    };

/// **MSFS Wave 2 (`(I-4a)` Strict-Pullback Beck-Chevalley Obstruction):**
/// On the exact strict 2-pullback `1 = {0 < 1} x_{0 < a < 1} {0 < 1}`, all four
/// functors preserve pullbacks and admit right adjoints (`u_*`, `g_*`, `f_* = v_* = *`),
/// yet the canonical mate `v_!(f_*(1)) = 0 < 1 = g_*(u_!(1))` is strictly non-invertible.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B5 — (I-4a) strict-pullback Beck-Chevalley mate failure (0 < 1)")
public theorem wave2_i4a_strict_pb_bc_failure(
    u0: Int, u1: Int, u2: Int,
    g0: Int, g1: Int, g2: Int,
    f_star_1: Int,
)
    requires is_right_adj_u(u0, u1, u2)
          && is_right_adj_g(g0, g1, g2)
          && f_star_1 == 0
    ensures strict_pb_c1_c2_size(0) == 1
         && u0 == 0 && u1 == 0 && u2 == 1
         && g0 == 0 && g1 == 1 && g2 == 1
         && v_bang_pb(f_star_1) == 0
         && map3_at(g0, g1, g2, u_bang(1)) == 1
         && v_bang_pb(f_star_1) < map3_at(g0, g1, g2, u_bang(1))
    proof {
        have h_pb: strict_pb_c1_c2_size(0) == 1 by auto;
        have h_adj: u0 == 0 && u1 == 0 && u2 == 1 && g0 == 0 && g1 == 1 && g2 == 1 by auto;
        have h_bc: v_bang_pb(f_star_1) == 0 && map3_at(g0, g1, g2, u_bang(1)) == 1 by auto;
        conclude by auto;
    };
