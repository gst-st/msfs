// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Stub("unverified-schematic"),
)
module lib.theorems.msfs.paraconsistent;

mount core.math.rich_s.conditions.{RichS};

/// MSFS Definition B.1 — Paraconsistent R-S (schematic stub).
/// - (Explosion-min): `\exists \phi. \bot \nvdash_{S'} \phi` (non-explosion),
/// - (Strong-neg): `\exists \sim. (p \wedge \sim p) \vdash_\sim \bot`,
/// - (Classical-kernel-extractability): an explicitly specified consistent
///   classical fragment `S* ∈ R-S` (translation preserving boundary predicates
///   is an explicit additional hypothesis of Theorem `thm:paraconsistent-afnt`).
@accessibility(omega_1)
@enact(epsilon = "ε_prove")
@framework(msfs, "MSFS Definition B.1 — Paraconsistent R-S (schematic stub)")
public axiom msfs_definition_B_1_paraconsistent_rich_s<S: RichS>(s_star: &S) -> Bool
requires true
ensures s_star.n_S() >= -1;

/// **MSFS Theorem B.2 — Conditional transfer to a paraconsistent presentation (schematic stub).**
/// Conditional on an explicitly supplied classical kernel `S* ∈ R-S` and a
/// translation `S' -> S*` sending every L_Abs candidate in `S'` to an L_Abs
/// candidate in `S*` within the scope of Theorem `thm:afnt-alpha`.
/// NOTE: Neither a strong negation nor stripping negation symbols constructs
/// this translation automatically.
@accessibility(omega_1)
@enact(epsilon = "ε_prove")
@framework(msfs, "MSFS Theorem B.2 — conditional paraconsistent transfer (schematic stub)")
public axiom msfs_theorem_B_2_paraconsistent_afnt<S: RichS>(s_star: &S) -> Bool
requires true
ensures s_star.n_S() >= -1;
