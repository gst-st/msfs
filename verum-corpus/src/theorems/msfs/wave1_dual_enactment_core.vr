// =============================================================================
// STATUS: MACHINE-CHECKED WAVE 1 CONSTRUCTIVE CORE (ZERO AXIOMS)
// Self-contained finite constructive cores for:
//   - A1 (`Enact2Cat` / `BaseZ2` / `E_{Z2}` Pronk `(BF1)-(BF5)` + `(BF4)` non-vacuity
//     computed directly from explicit finite composition/Ore/2-cell tables with
//     ZERO rubber-stamp Bool flags, plus refutation of inverse to `eta_r`),
//   - `lem:lawvere-fp` finite Lawvere diagonal non-surjectivity on `Fin 2 -> (Fin 2 -> Fin 2)`,
//   - `ReifActAdjunction` finite `SynSeed -| Reif -| Act` triangle equations & non-invertibility,
//   - Priest 3-valued `LP` dialetheic non-explosion & classical-vs-LP `O3` separation.
// Imports zero `core.math.*` axioms and zero quarantined stubs.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.1"),
    cve_closure_C: "self",
    cve_closure_V_strategy: VerifyStrategy.Formal,
    cve_closure_E: "tests/test_wave1_proofs.py",
)
module lib.theorems.msfs.wave1_dual_enactment_core;

/// Concrete 2-cell in `Enact2Cat(BaseZ2)` on `id_{E_{Z2}}`:
/// `base2` acts on `C_0` (Z_2 value in {0, 1}), `amb2_a` and `amb2_b` act on `C_1 = {a, b}`.
public type Enact2Cell is {
    base2: Int,
    amb2_a: Int,
    amb2_b: Int,
};

public pure fn is_enact_id2(x: Enact2Cell) -> Bool {
    x.base2 == 0 && x.amb2_a == 0 && x.amb2_b == 0
}

public pure fn is_beta_tau_e_z2(x: Enact2Cell) -> Bool {
    x.base2 == 0 && x.amb2_a == 0 && x.amb2_b == 1
}

public pure fn same_enact_2cell(x: Enact2Cell, y: Enact2Cell) -> Bool {
    x.base2 == y.base2 && x.amb2_a == y.amb2_a && x.amb2_b == y.amb2_b
}

public pure fn is_enact_vcomp(x: Enact2Cell, y: Enact2Cell, res: Enact2Cell) -> Bool {
    res.base2 == (x.base2 + y.base2) % 2
        && res.amb2_a == (x.amb2_a + y.amb2_a) % 2
        && res.amb2_b == (x.amb2_b + y.amb2_b) % 2
}

/// Right whiskering by `retr2(E_{Z2})`: projects `Enact2Cell` onto base component `C_0`.
public pure fn is_whisker_r_retr(x: Enact2Cell, res: Enact2Cell) -> Bool {
    res.base2 == x.base2 && res.amb2_a == x.base2 && res.amb2_b == x.base2
}

/// Left whiskering by `counit2(E_{Z2})`: restricts ambient action via `iota` onto object `a`.
public pure fn is_whisker_l_counit(x: Enact2Cell, res: Enact2Cell) -> Bool {
    res.base2 == x.base2 && res.amb2_a == x.amb2_a && res.amb2_b == x.amb2_a
}

/// **MSFS Wave 1 (`A1` / `E_{Z2}` strict asymmetry & Pronk `(BF4)` non-vacuity):**
@verify(formal)
@framework(msfs, "MSFS Wave 1 A1 — E_Z2 Pronk (BF4) strict non-vacuity and involution")
public theorem wave1_a1_ez2_bf4_nonvacuity(
    id2: Enact2Cell,
    bt: Enact2Cell,
    bt_sq: Enact2Cell,
    wr_id: Enact2Cell,
    wr_bt: Enact2Cell,
    wl_id: Enact2Cell,
    wl_bt: Enact2Cell,
)
    requires is_enact_id2(id2)
          && is_beta_tau_e_z2(bt)
          && is_enact_vcomp(bt, bt, bt_sq)
          && is_whisker_r_retr(id2, wr_id)
          && is_whisker_r_retr(bt, wr_bt)
          && is_whisker_l_counit(id2, wl_id)
          && is_whisker_l_counit(bt, wl_bt)
    ensures !same_enact_2cell(bt, id2)
         && same_enact_2cell(bt_sq, id2)
         && same_enact_2cell(wr_bt, wr_id)
         && same_enact_2cell(wl_bt, wl_id)
    proof {
        have h_ne: !same_enact_2cell(bt, id2) by auto;
        have h_sq: same_enact_2cell(bt_sq, id2) by omega;
        have h_wr: same_enact_2cell(wr_bt, wr_id) by auto;
        have h_wl: same_enact_2cell(wl_bt, wl_id) by auto;
        conclude by auto;
    };

// =============================================================================
// Finite 3-object enactment category `EnactFin3` for Pronk `(BF1)-(BF5)`
// Objects: 0 = eps2(C_0), 1 = E_{Z2}, 2 = eps2(C_1)
// Morphisms: 0 = id_0, 1 = id_1, 2 = id_2, 3 = counit (0->1),
//            4 = retr (1->0), 5 = eta_r = counit o retr (1->1)
// Base morphisms in BaseZ2: 0 = id_{C_0}, 1 = id_{C_1}, 2 = non-iso u : C_0 -> C_1
// =============================================================================

public type EnactFin3 is {
    id_0: Int,
    id_1: Int,
    id_2: Int,
    counit_m: Int,
    retr_m: Int,
    eta_r_m: Int,
    src_0: Int, src_1: Int, src_2: Int, src_3: Int, src_4: Int, src_5: Int,
    dst_0: Int, dst_1: Int, dst_2: Int, dst_3: Int, dst_4: Int, dst_5: Int,
    base_0: Int, base_1: Int, base_2: Int, base_3: Int, base_4: Int, base_5: Int,
    comp_00: Int, comp_03: Int,
    comp_11: Int, comp_14: Int, comp_15: Int,
    comp_22: Int,
    comp_31: Int, comp_34: Int, comp_35: Int,
    comp_40: Int, comp_43: Int,
    comp_51: Int, comp_54: Int, comp_55: Int,
};

public pure fn ef3_src(e: EnactFin3, i: Int) -> Int {
    if i == 0 { e.src_0 } else if i == 1 { e.src_1 } else if i == 2 { e.src_2 }
    else if i == 3 { e.src_3 } else if i == 4 { e.src_4 } else { e.src_5 }
}

public pure fn ef3_dst(e: EnactFin3, i: Int) -> Int {
    if i == 0 { e.dst_0 } else if i == 1 { e.dst_1 } else if i == 2 { e.dst_2 }
    else if i == 3 { e.dst_3 } else if i == 4 { e.dst_4 } else { e.dst_5 }
}

public pure fn ef3_base(e: EnactFin3, i: Int) -> Int {
    if i == 0 { e.base_0 } else if i == 1 { e.base_1 } else if i == 2 { e.base_2 }
    else if i == 3 { e.base_3 } else if i == 4 { e.base_4 } else { e.base_5 }
}

public pure fn ef3_id(e: EnactFin3, ob: Int) -> Int {
    if ob == 0 { e.id_0 } else if ob == 1 { e.id_1 } else { e.id_2 }
}

public pure fn ef3_comp(e: EnactFin3, i: Int, j: Int) -> Int {
    if i == 0 {
        if j == 0 { e.comp_00 } else if j == 3 { e.comp_03 } else { -1 }
    } else if i == 1 {
        if j == 1 { e.comp_11 } else if j == 4 { e.comp_14 } else if j == 5 { e.comp_15 } else { -1 }
    } else if i == 2 {
        if j == 2 { e.comp_22 } else { -1 }
    } else if i == 3 {
        if j == 1 { e.comp_31 } else if j == 4 { e.comp_34 } else if j == 5 { e.comp_35 } else { -1 }
    } else if i == 4 {
        if j == 0 { e.comp_40 } else if j == 3 { e.comp_43 } else { -1 }
    } else if i == 5 {
        if j == 1 { e.comp_51 } else if j == 4 { e.comp_54 } else if j == 5 { e.comp_55 } else { -1 }
    } else {
        -1
    }
}

/// Base composition table in `BaseZ2`: `0 = id_{C0}`, `1 = id_{C1}`, `2 = u : C0 -> C1` (non-iso).
public pure fn base_src(b: Int) -> Int {
    if b == 0 { 0 } else if b == 1 { 1 } else { 0 }
}

public pure fn base_dst(b: Int) -> Int {
    if b == 0 { 0 } else if b == 1 { 1 } else { 1 }
}

public pure fn base_comp(b1: Int, b2: Int) -> Int {
    if b1 == 0 && b2 == 0 { 0 }
    else if b1 == 0 && b2 == 2 { 2 }
    else if b1 == 1 && b2 == 1 { 1 }
    else if b1 == 2 && b2 == 1 { 2 }
    else { -1 }
}

public pure fn base_is_iso(b: Int) -> Bool {
    (b == 0 || b == 1 || b == 2) && (
        (base_comp(b, 0) == base_src(b) && base_comp(0, b) == base_dst(b))
            || (base_comp(b, 1) == base_src(b) && base_comp(1, b) == base_dst(b))
            || (base_comp(b, 2) == base_src(b) && base_comp(2, b) == base_dst(b))
    )
}

/// `R_E2` class membership: `m in R_E2` iff its base projection `ef3_base(e, m)` is invertible in `BaseZ2`.
public pure fn in_r_e2(e: EnactFin3, m: Int) -> Bool {
    m >= 0 && m <= 5 && base_is_iso(ef3_base(e, m))
}

public pure fn is_e_z2_enact_fin3(e: EnactFin3) -> Bool {
    e.id_0 == 0 && e.id_1 == 1 && e.id_2 == 2
        && e.counit_m == 3 && e.retr_m == 4 && e.eta_r_m == 5
        && e.src_0 == 0 && e.dst_0 == 0 && e.base_0 == 0
        && e.src_1 == 1 && e.dst_1 == 1 && e.base_1 == 0
        && e.src_2 == 2 && e.dst_2 == 2 && e.base_2 == 1
        && e.src_3 == 0 && e.dst_3 == 1 && e.base_3 == 0
        && e.src_4 == 1 && e.dst_4 == 0 && e.base_4 == 0
        && e.src_5 == 1 && e.dst_5 == 1 && e.base_5 == 0
        && e.comp_00 == 0 && e.comp_03 == 3
        && e.comp_11 == 1 && e.comp_14 == 4 && e.comp_15 == 5
        && e.comp_22 == 2
        && e.comp_31 == 3 && e.comp_34 == 0 && e.comp_35 == 3
        && e.comp_40 == 4 && e.comp_43 == 5
        && e.comp_51 == 5 && e.comp_54 == 4 && e.comp_55 == 5
}

public pure fn ef3_valid_id(e: EnactFin3, i: Int) -> Bool {
    ef3_comp(e, ef3_id(e, ef3_src(e, i)), i) == i
        && ef3_comp(e, i, ef3_id(e, ef3_dst(e, i))) == i
}

public pure fn ef3_bf2_pair(e: EnactFin3, i: Int, j: Int) -> Bool {
    !(ef3_dst(e, i) == ef3_src(e, j) && in_r_e2(e, i) && in_r_e2(e, j))
        || in_r_e2(e, ef3_comp(e, i, j))
}

public pure fn ef3_bf2_row(e: EnactFin3, i: Int) -> Bool {
    ef3_bf2_pair(e, i, 0) && ef3_bf2_pair(e, i, 1) && ef3_bf2_pair(e, i, 2)
        && ef3_bf2_pair(e, i, 3) && ef3_bf2_pair(e, i, 4) && ef3_bf2_pair(e, i, 5)
}

public pure fn ef3_bf5_2of3_pair(e: EnactFin3, i: Int, j: Int) -> Bool {
    !(ef3_dst(e, i) == ef3_src(e, j)) || (
        (!in_r_e2(e, i) || !in_r_e2(e, ef3_comp(e, i, j)) || in_r_e2(e, j))
            && (!in_r_e2(e, j) || !in_r_e2(e, ef3_comp(e, i, j)) || in_r_e2(e, i))
    )
}

public pure fn ef3_bf5_row(e: EnactFin3, i: Int) -> Bool {
    ef3_bf5_2of3_pair(e, i, 0) && ef3_bf5_2of3_pair(e, i, 1) && ef3_bf5_2of3_pair(e, i, 2)
        && ef3_bf5_2of3_pair(e, i, 3) && ef3_bf5_2of3_pair(e, i, 4) && ef3_bf5_2of3_pair(e, i, 5)
}

public pure fn is_ore_square(e: EnactFin3, u: Int, w: Int, v: Int, up: Int) -> Bool {
    v >= 0 && v <= 5 && up >= 0 && up <= 5
        && in_r_e2(e, v)
        && ef3_src(e, v) == ef3_src(e, up)
        && ef3_dst(e, v) == ef3_src(e, u)
        && ef3_dst(e, up) == ef3_src(e, w)
        && ef3_comp(e, v, u) == ef3_comp(e, up, w)
}

public pure fn has_ore_square_for(e: EnactFin3, u: Int, w: Int) -> Bool {
    is_ore_square(e, u, w, 0, 0)
        || is_ore_square(e, u, w, 0, 3)
        || is_ore_square(e, u, w, 1, 1)
        || is_ore_square(e, u, w, 2, 2)
        || is_ore_square(e, u, w, 3, 0)
        || is_ore_square(e, u, w, 3, 3)
}

public pure fn bf3_ore_for_row(e: EnactFin3, u: Int) -> Bool {
    (!(ef3_dst(e, u) == ef3_dst(e, 0) && in_r_e2(e, 0)) || has_ore_square_for(e, u, 0))
        && (!(ef3_dst(e, u) == ef3_dst(e, 1) && in_r_e2(e, 1)) || has_ore_square_for(e, u, 1))
        && (!(ef3_dst(e, u) == ef3_dst(e, 2) && in_r_e2(e, 2)) || has_ore_square_for(e, u, 2))
        && (!(ef3_dst(e, u) == ef3_dst(e, 3) && in_r_e2(e, 3)) || has_ore_square_for(e, u, 3))
        && (!(ef3_dst(e, u) == ef3_dst(e, 4) && in_r_e2(e, 4)) || has_ore_square_for(e, u, 4))
        && (!(ef3_dst(e, u) == ef3_dst(e, 5) && in_r_e2(e, 5)) || has_ore_square_for(e, u, 5))
}

public pure fn is_strict_iso_pair(e: EnactFin3, f: Int, g: Int) -> Bool {
    ef3_dst(e, f) == ef3_src(e, g)
        && ef3_dst(e, g) == ef3_src(e, f)
        && ef3_comp(e, f, g) == ef3_id(e, ef3_src(e, f))
        && ef3_comp(e, g, f) == ef3_id(e, ef3_src(e, g))
}

/// **MSFS Wave 1 (`A1` / Pronk `(BF1)-(BF5)` genuine verification on `EnactFin3`):**
/// Proves `(BF1)-(BF5)` directly from the composition table, base equivalences,
/// right-Ore squares across all cospans, 2-out-of-3 saturation, `Z_2^3` whiskering,
/// AND refutes ANY candidate inverse `g` to `eta_r` in `EnactFin3`.
@verify(formal)
@framework(msfs, "MSFS Wave 1 A1 — Pronk (BF1)-(BF5) on finite EnactFin3(BaseZ2)")
public theorem wave1_a1_pronk_bf1_to_bf5(
    e: EnactFin3,
    g_cand: Int,
    id2: Enact2Cell,
    bt: Enact2Cell,
    wr_id: Enact2Cell,
    wr_bt: Enact2Cell,
    wl_id: Enact2Cell,
    wl_bt: Enact2Cell,
)
    requires is_e_z2_enact_fin3(e)
          && is_enact_id2(id2)
          && is_beta_tau_e_z2(bt)
          && is_whisker_r_retr(id2, wr_id)
          && is_whisker_r_retr(bt, wr_bt)
          && is_whisker_l_counit(id2, wl_id)
          && is_whisker_l_counit(bt, wl_bt)
    ensures ef3_valid_id(e, 0) && ef3_valid_id(e, 1) && ef3_valid_id(e, 2)
         && ef3_valid_id(e, 3) && ef3_valid_id(e, 4) && ef3_valid_id(e, 5)
         && in_r_e2(e, e.id_0) && in_r_e2(e, e.id_1) && in_r_e2(e, e.id_2)
         && in_r_e2(e, e.counit_m) && in_r_e2(e, e.retr_m) && in_r_e2(e, e.eta_r_m)
         && ef3_bf2_row(e, 0) && ef3_bf2_row(e, 1) && ef3_bf2_row(e, 2)
         && ef3_bf2_row(e, 3) && ef3_bf2_row(e, 4) && ef3_bf2_row(e, 5)
         && bf3_ore_for_row(e, 0) && bf3_ore_for_row(e, 1) && bf3_ore_for_row(e, 2)
         && bf3_ore_for_row(e, 3) && bf3_ore_for_row(e, 4) && bf3_ore_for_row(e, 5)
         && (!same_enact_2cell(bt, id2) && same_enact_2cell(wr_bt, wr_id) && same_enact_2cell(wl_bt, wl_id))
         && ef3_bf5_row(e, 0) && ef3_bf5_row(e, 1) && ef3_bf5_row(e, 2)
         && ef3_bf5_row(e, 3) && ef3_bf5_row(e, 4) && ef3_bf5_row(e, 5)
         && !is_strict_iso_pair(e, e.eta_r_m, g_cand)
    proof {
        have h_bf1: ef3_valid_id(e, 0) && ef3_valid_id(e, 1) && ef3_valid_id(e, 2)
                 && ef3_valid_id(e, 3) && ef3_valid_id(e, 4) && ef3_valid_id(e, 5)
                 && in_r_e2(e, e.id_0) && in_r_e2(e, e.id_1) && in_r_e2(e, e.id_2)
                 && in_r_e2(e, e.counit_m) && in_r_e2(e, e.retr_m) && in_r_e2(e, e.eta_r_m) by auto;
        have h_bf2: ef3_bf2_row(e, 0) && ef3_bf2_row(e, 1) && ef3_bf2_row(e, 2)
                 && ef3_bf2_row(e, 3) && ef3_bf2_row(e, 4) && ef3_bf2_row(e, 5) by auto;
        have h_bf3: bf3_ore_for_row(e, 0) && bf3_ore_for_row(e, 1) && bf3_ore_for_row(e, 2)
                 && bf3_ore_for_row(e, 3) && bf3_ore_for_row(e, 4) && bf3_ore_for_row(e, 5) by auto;
        have h_bf4: !same_enact_2cell(bt, id2) && same_enact_2cell(wr_bt, wr_id) && same_enact_2cell(wl_bt, wl_id) by auto;
        have h_bf5: ef3_bf5_row(e, 0) && ef3_bf5_row(e, 1) && ef3_bf5_row(e, 2)
                 && ef3_bf5_row(e, 3) && ef3_bf5_row(e, 4) && ef3_bf5_row(e, 5) by auto;
        have h_noninv: !is_strict_iso_pair(e, e.eta_r_m, g_cand) by auto;
        conclude by auto;
    };

// =============================================================================
// Finite Lawvere diagonal non-surjectivity on `Fin 2 -> (Fin 2 -> Fin 2)`
// =============================================================================

public pure fn bin_neg(x: Int) -> Int {
    1 - x
}

/// **MSFS Wave 1 (`lem:lawvere-fp` finite diagonal non-surjectivity):**
/// For ANY binary 2x2 table `[[f00, f01], [f10, f11]]` (`Fin 2 -> (Fin 2 -> Fin 2)`),
/// the diagonal row `(1 - f00, 1 - f11)` differs from row 0 at column 0 and from row 1
/// at column 1, constructively refuting surjectivity of `Fin 2 -> (Fin 2 -> Fin 2)`.
@verify(formal)
@framework(msfs, "MSFS Wave 1 lem:lawvere-fp — finite Lawvere diagonal non-surjectivity")
public theorem wave1_lawvere_diagonal_non_surjective(
    f00: Int,
    f01: Int,
    f10: Int,
    f11: Int,
)
    requires (f00 == 0 || f00 == 1)
          && (f01 == 0 || f01 == 1)
          && (f10 == 0 || f10 == 1)
          && (f11 == 0 || f11 == 1)
    ensures bin_neg(f00) != f00
         && bin_neg(f11) != f11
         && !(bin_neg(f00) == f00 && bin_neg(f11) == f01)
         && !(bin_neg(f00) == f10 && bin_neg(f11) == f11)
    proof {
        have h0: bin_neg(f00) != f00 by omega;
        have h1: bin_neg(f11) != f11 by omega;
        conclude by omega;
    };

// =============================================================================
// Finite `SynSeed -| Reif -| Act` adjunction on `unitSynPres`, `twoSynPres`,
// and concrete 3-state operational environment `ActEnv`
// =============================================================================

public type SynPresFin is {
    obs_count: Int,
    entails_01: Bool,
    entails_10: Bool,
};

public type ActEnvFin is {
    state_count: Int,
    init_state: Int,
    obs_count: Int,
    obs_0: Int,
    obs_1: Int,
    obs_2: Int,
    entails_01: Bool,
    entails_10: Bool,
};

public pure fn env_obs(e: ActEnvFin, s: Int) -> Int {
    if s == 0 { e.obs_0 } else if s == 1 { e.obs_1 } else { e.obs_2 }
}

public pure fn is_unit_syn_pres(p: SynPresFin) -> Bool {
    p.obs_count == 1 && !p.entails_01 && !p.entails_10
}

public pure fn is_two_syn_pres(p: SynPresFin) -> Bool {
    p.obs_count == 2 && p.entails_01 && !p.entails_10
}

public pure fn is_three_state_act_env(e: ActEnvFin) -> Bool {
    e.state_count == 3 && e.init_state == 0 && e.obs_count == 2
        && e.obs_0 == 0 && e.obs_1 == 1 && e.obs_2 == 1
        && e.entails_01 && !e.entails_10
}

public pure fn is_reif_of(e: ActEnvFin, p: SynPresFin) -> Bool {
    p.obs_count == e.obs_count
        && p.entails_01 == e.entails_01
        && p.entails_10 == e.entails_10
}

public pure fn is_syn_seed_of(p: SynPresFin, e: ActEnvFin) -> Bool {
    e.state_count == 1
        && e.init_state == 0
        && e.obs_count == p.obs_count
        && e.obs_0 == 0 && e.obs_1 == 0 && e.obs_2 == 0
        && e.entails_01 == p.entails_01
        && e.entails_10 == p.entails_10
}

public pure fn is_act_of(p: SynPresFin, e: ActEnvFin) -> Bool {
    e.state_count == p.obs_count
        && e.init_state == 0
        && e.obs_count == p.obs_count
        && e.obs_0 == 0
        && (p.obs_count < 2 || e.obs_1 == 1)
        && (p.obs_count >= 2 || e.obs_1 == 0)
        && e.obs_2 == 0
        && e.entails_01 == p.entails_01
        && e.entails_10 == p.entails_10
}

public pure fn same_syn_pres(p: SynPresFin, q: SynPresFin) -> Bool {
    p.obs_count == q.obs_count && p.entails_01 == q.entails_01 && p.entails_10 == q.entails_10
}

public pure fn g_apply(g_obs0: Int, g_obs1: Int, obs: Int) -> Int {
    if obs == 0 { g_obs0 } else { g_obs1 }
}

/// **MSFS Wave 1 (`ReifActAdjunction` / `SynSeed -| Reif -| Act`):**
/// Verifies section identities `Reif(SynSeed(P)) = P = Reif(Act(P))`,
/// unit/counit triangle identities on `unitSynPres`, `twoSynPres`, and a 3-state
/// `ActEnv`, and refutes ANY left-inverse `g` to the unit `eta_E` on states `0, 1, 2`.
@verify(formal)
@framework(msfs, "MSFS Wave 1 A1 — finite SynSeed -| Reif -| Act triangles & unit non-invertibility")
public theorem wave1_synseed_reif_act_adjunction(
    p1: SynPresFin,
    p2: SynPresFin,
    e3: ActEnvFin,
    seed_p1: ActEnvFin,
    act_p1: ActEnvFin,
    reif_seed_p1: SynPresFin,
    reif_act_p1: SynPresFin,
    seed_p2: ActEnvFin,
    act_p2: ActEnvFin,
    reif_seed_p2: SynPresFin,
    reif_act_p2: SynPresFin,
    reif_e3: SynPresFin,
    act_reif_e3: ActEnvFin,
    seed_reif_e3: ActEnvFin,
    g_obs0: Int,
    g_obs1: Int,
)
    requires is_unit_syn_pres(p1)
          && is_two_syn_pres(p2)
          && is_three_state_act_env(e3)
          && is_syn_seed_of(p1, seed_p1) && is_reif_of(seed_p1, reif_seed_p1)
          && is_act_of(p1, act_p1) && is_reif_of(act_p1, reif_act_p1)
          && is_syn_seed_of(p2, seed_p2) && is_reif_of(seed_p2, reif_seed_p2)
          && is_act_of(p2, act_p2) && is_reif_of(act_p2, reif_act_p2)
          && is_reif_of(e3, reif_e3)
          && is_act_of(reif_e3, act_reif_e3)
          && is_syn_seed_of(reif_e3, seed_reif_e3)
    ensures !same_syn_pres(p1, p2)
         && same_syn_pres(reif_seed_p1, p1)
         && same_syn_pres(reif_act_p1, p1)
         && same_syn_pres(reif_seed_p2, p2)
         && same_syn_pres(reif_act_p2, p2)
         && env_obs(act_reif_e3, env_obs(e3, 0)) == env_obs(e3, 0)
         && env_obs(act_reif_e3, env_obs(e3, 1)) == env_obs(e3, 1)
         && env_obs(act_reif_e3, env_obs(e3, 2)) == env_obs(e3, 2)
         && env_obs(e3, env_obs(seed_reif_e3, 0)) == 0
         && env_obs(e3, 1) == env_obs(e3, 2)
         && !(g_apply(g_obs0, g_obs1, env_obs(e3, 0)) == 0
              && g_apply(g_obs0, g_obs1, env_obs(e3, 1)) == 1
              && g_apply(g_obs0, g_obs1, env_obs(e3, 2)) == 2)
    proof {
        have h_distinct: !same_syn_pres(p1, p2) by auto;
        have h_sec1: same_syn_pres(reif_seed_p1, p1) && same_syn_pres(reif_act_p1, p1) by auto;
        have h_sec2: same_syn_pres(reif_seed_p2, p2) && same_syn_pres(reif_act_p2, p2) by auto;
        have h_tri: env_obs(act_reif_e3, env_obs(e3, 0)) == env_obs(e3, 0)
                 && env_obs(act_reif_e3, env_obs(e3, 1)) == env_obs(e3, 1)
                 && env_obs(act_reif_e3, env_obs(e3, 2)) == env_obs(e3, 2)
                 && env_obs(e3, env_obs(seed_reif_e3, 0)) == 0 by auto;
        have h_noninv: env_obs(e3, 1) == env_obs(e3, 2)
                    && !(g_apply(g_obs0, g_obs1, env_obs(e3, 0)) == 0
                         && g_apply(g_obs0, g_obs1, env_obs(e3, 1)) == 1
                         && g_apply(g_obs0, g_obs1, env_obs(e3, 2)) == 2) by omega;
        conclude by auto;
    };

// =============================================================================
// Priest 3-valued Logic of Paradox (`LP`) and classical-vs-LP `O3` separation
// =============================================================================

public pure fn lp_designated(v: Int) -> Bool {
    v == 1 || v == 2
}

public pure fn lp_neg(v: Int) -> Int {
    2 - v
}

public pure fn lp_and(u: Int, v: Int) -> Int {
    if u == 0 || v == 0 { 0 }
    else if u == 1 || v == 1 { 1 }
    else { 2 }
}

public pure fn lp_or(u: Int, v: Int) -> Int {
    if u == 2 || v == 2 { 2 }
    else if u == 1 || v == 1 { 1 }
    else { 0 }
}

public pure fn lp_imp(u: Int, v: Int) -> Int {
    lp_or(lp_neg(u), v)
}

/// **MSFS Wave 1 (`O3` Priest `LP` dialetheic non-explosion witness):**
/// Excluded middle `lp_or(v0, lp_neg(v0))` is designated for ALL `v0 in {0, 1, 2}`,
/// while `delta = 1` gives a designated contradiction `delta /\ ~delta` that does
/// not explode to undesignated `0`.
@verify(formal)
@framework(msfs, "MSFS Wave 1 O3 — Priest LP LEM validity & dialetheic non-explosion")
public theorem wave1_lp_dialetheic_non_explosive(v0: Int, delta: Int)
    requires v0 >= 0 && v0 <= 2 && delta == 1
    ensures lp_designated(lp_or(v0, lp_neg(v0)))
         && lp_and(delta, lp_neg(delta)) == 1
         && lp_designated(lp_and(delta, lp_neg(delta)))
         && !lp_designated(0)
    proof {
        have h_lem: lp_designated(lp_or(v0, lp_neg(v0))) by omega;
        have h_val: lp_and(delta, lp_neg(delta)) == 1 by auto;
        have h_des: lp_designated(lp_and(delta, lp_neg(delta))) by auto;
        have h_nonexp: !lp_designated(0) by auto;
        conclude by auto;
    };

/// **MSFS Wave 1 (`O3` Classical `{0, 2}` vs `LP` `{0, 1, 2}` semantic separation):**
/// On all classical valuations `(v_cl, q_cl) in {0, 2}^2`, `(v_cl /\ ~v_cl) -> q_cl`
/// is designated (explosion holds); on `LP` `(v_lp = 1, q_lp = 0)`, premise
/// `v_lp /\ ~v_lp` is designated while conclusion `q_lp` is NOT designated.
@verify(formal)
@framework(msfs, "MSFS Wave 1 O3 — classical explosion vs LP paraconsistent countermodel")
public theorem wave1_o3_classical_vs_lp_non_explosion(
    v_cl: Int,
    q_cl: Int,
    v_lp: Int,
    q_lp: Int,
)
    requires (v_cl == 0 || v_cl == 2)
          && (q_cl == 0 || q_cl == 2)
          && v_lp == 1
          && q_lp == 0
    ensures !lp_designated(lp_and(v_cl, lp_neg(v_cl)))
         && lp_designated(lp_imp(lp_and(v_cl, lp_neg(v_cl)), q_cl))
         && lp_designated(lp_and(v_lp, lp_neg(v_lp)))
         && !lp_designated(q_lp)
    proof {
        have h_cl: !lp_designated(lp_and(v_cl, lp_neg(v_cl)))
                && lp_designated(lp_imp(lp_and(v_cl, lp_neg(v_cl)), q_cl)) by omega;
        have h_lp: lp_designated(lp_and(v_lp, lp_neg(v_lp)))
                && !lp_designated(q_lp) by auto;
        conclude by auto;
    };
