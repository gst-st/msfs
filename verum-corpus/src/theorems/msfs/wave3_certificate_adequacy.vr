// =============================================================================
// STATUS: WAVE 3 CONSTRUCTIVE SPEC (ZERO AXIOMS — WAVE 2 GATE COMPLIANT)
// Self-contained finite constructive cores for Axis 4:
//   1. `wave3_tariff_semilattice_and_diag_pb_obstruction`: exact 12-tier T_12
//      incomparability, R-1 OpaqueAI absorption, and Theorem 4.8 universal
//      diagonal positive-tariff strict pullback obstruction;
//   2. `wave3_adeq2cat_conical_noncancellation_and_w2`: conical (drift_pos, drift_neg)
//      Adeq2Cat forbidding F_+ ~= F_-, proving Clock-Trap +1 >> -1 non-cancellation
//      and (W2) directed non-invertibility;
//   3. `wave3_cm_adeq_1_to_4_independence`: parametric 4-point specification records
//      verifying universal Kernel=PASS + exact 4x4 diagonal failure matrix for CM-Adeq-1..4;
//   4. `wave3_letbind_dag_vs_tree_actcost_gap`: parametric BudgetedEnv separation
//      (act_cost_grade, same_reif_shadow, !is_act_iso) at k = 4, 10, 14;
//   5. `wave3_php_exact_crossovers`: parametric exact TreeRes vs IPS (n=19) and
//      TreeRes vs EF (n=28) crossovers + pre-crossover reversals (n=18, 27).
// Imports zero `core.math.*` axioms and zero `: Bool` record fields.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.3"),
    cve_closure_C: "self",
    cve_closure_V_strategy: VerifyStrategy.Formal,
    cve_closure_E: "tests/test_wave3_certificate_adequacy.py",
)
module lib.theorems.msfs.wave3_certificate_adequacy;

public type TariffCoord is {
    cls_rank: Int,
    con_rank: Int,
};

public pure fn is_valid_t12_coord(t: TariffCoord) -> Bool {
    (t.cls_rank == 0 && t.con_rank == 0)
        || (t.cls_rank == 1 && t.con_rank == 1)
        || (t.cls_rank == 2 && t.con_rank == 2)
        || (t.cls_rank == 3 && t.con_rank == 2)
        || (t.cls_rank == 4 && t.con_rank == 2)
        || (t.cls_rank == 5 && t.con_rank == 2)
        || (t.cls_rank == 6 && t.con_rank == 2)
        || (t.cls_rank == 7 && t.con_rank == 2)
        || (t.cls_rank == 2 && t.con_rank == 3)
        || (t.cls_rank == 8 && t.con_rank == 4)
        || (t.cls_rank == 9 && t.con_rank == 5)
        || (t.cls_rank == 10 && t.con_rank == 6)
}

public pure fn le_tariff(a: TariffCoord, b: TariffCoord) -> Bool {
    a.cls_rank <= b.cls_rank && a.con_rank <= b.con_rank
}

public pure fn eq_tariff(a: TariffCoord, b: TariffCoord) -> Bool {
    a.cls_rank == b.cls_rank && a.con_rank == b.con_rank
}

public pure fn max_int(a: Int, b: Int) -> Int {
    if a <= b { b } else { a }
}

public pure fn join_cls(a: TariffCoord, b: TariffCoord) -> Int {
    if max_int(a.con_rank, b.con_rank) == 3 && max_int(a.cls_rank, b.cls_rank) >= 3 {
        8
    } else {
        max_int(a.cls_rank, b.cls_rank)
    }
}

public pure fn join_con(a: TariffCoord, b: TariffCoord) -> Int {
    if max_int(a.con_rank, b.con_rank) == 3 && max_int(a.cls_rank, b.cls_rank) >= 3 {
        4
    } else {
        max_int(a.con_rank, b.con_rank)
    }
}

public pure fn join_eq(a: TariffCoord, b: TariffCoord, c: TariffCoord) -> Bool {
    join_cls(a, b) == c.cls_rank && join_con(a, b) == c.con_rank
}

public pure fn is_linact(t: TariffCoord) -> Bool { t.cls_rank == 0 && t.con_rank == 0 }
public pure fn is_s21(t: TariffCoord) -> Bool    { t.cls_rank == 1 && t.con_rank == 1 }
public pure fn is_wkl0(t: TariffCoord) -> Bool   { t.cls_rank == 4 && t.con_rank == 2 }
public pure fn is_mltt(t: TariffCoord) -> Bool   { t.cls_rank == 2 && t.con_rank == 3 }
public pure fn is_zfc(t: TariffCoord) -> Bool    { t.cls_rank == 8 && t.con_rank == 4 }
public pure fn is_opaque(t: TariffCoord) -> Bool { t.cls_rank == 10 && t.con_rank == 6 }

/// **Wave 3 Theorem 1 (R-17A, R-1, & Theorem 4.8 Universal Diagonal Pullback Obstruction):**
/// Over the exact 12-element semilattice T_12 (zero phantom coords): WKL0 || MLTT join to ZFC,
/// OpaqueAI absorbs every tier, and NO (pi1, pi2) can mediate the diagonal cospan (t, t) for t != linAct.
@verify(formal)
@framework(msfs, "Axis 4 Wave 3 — T_12 incomparability, OpaqueAI absorption, and universal diagonal PB obstruction")
public theorem wave3_tariff_semilattice_and_diag_pb_obstruction(
    t: TariffCoord,
    wkl: TariffCoord,
    mltt: TariffCoord,
    zfc: TariffCoord,
    opq: TariffCoord,
    lin: TariffCoord,
    pi1: TariffCoord,
    pi2: TariffCoord,
    k1: TariffCoord,
    k2: TariffCoord,
)
    requires is_valid_t12_coord(t) && !is_linact(t)
          && is_wkl0(wkl) && is_mltt(mltt) && is_zfc(zfc) && is_opaque(opq) && is_linact(lin)
          && is_valid_t12_coord(pi1) && is_valid_t12_coord(pi2)
          && is_valid_t12_coord(k1) && is_valid_t12_coord(k2)
          && join_eq(k1, pi1, lin)
          && join_eq(k1, pi2, lin)
          && join_eq(k2, pi1, lin)
    ensures !le_tariff(wkl, mltt)
         && !le_tariff(mltt, wkl)
         && join_eq(wkl, mltt, zfc)
         && join_eq(opq, t, opq)
         && is_linact(pi1)
         && is_linact(pi2)
         && !join_eq(k2, pi2, t)
    proof {
        have h_incomp: !le_tariff(wkl, mltt) && !le_tariff(mltt, wkl) by omega;
        have h_zfc: join_eq(wkl, mltt, zfc) by omega;
        have h_abs: join_eq(opq, t, opq) by omega;
        have h_pis: is_linact(pi1) && is_linact(pi2) by omega;
        have h_k2: is_linact(k2) by omega;
        have h_obs: !join_eq(k2, pi2, t) by omega;
        conclude by auto;
    };

public type AdeqTransFin is {
    cost_slope: Int,
    cost_bias: Int,
    drift_pos: Int,
    drift_neg: Int,
    cls_rank: Int,
    con_rank: Int,
};

public pure fn valid_t12_pair(c: Int, k: Int) -> Bool {
    (c == 0 && k == 0)
        || (c == 1 && k == 1)
        || (c == 2 && k == 2)
        || (c == 3 && k == 2)
        || (c == 4 && k == 2)
        || (c == 5 && k == 2)
        || (c == 6 && k == 2)
        || (c == 7 && k == 2)
        || (c == 2 && k == 3)
        || (c == 8 && k == 4)
        || (c == 9 && k == 5)
        || (c == 10 && k == 6)
}

public pure fn valid_adeq_trans(f: AdeqTransFin) -> Bool {
    f.cost_slope >= 1 && f.cost_bias >= 0
        && f.drift_pos >= 0 && f.drift_neg >= 0
        && valid_t12_pair(f.cls_rank, f.con_rank)
}

public pure fn total_drift(f: AdeqTransFin) -> Int {
    f.drift_pos + f.drift_neg
}

public pure fn signed_shift(f: AdeqTransFin) -> Int {
    f.drift_pos - f.drift_neg
}

public pure fn join_cls_pair(c1: Int, k1: Int, c2: Int, k2: Int) -> Int {
    if max_int(k1, k2) == 3 && max_int(c1, c2) >= 3 { 8 } else { max_int(c1, c2) }
}

public pure fn join_con_pair(c1: Int, k1: Int, c2: Int, k2: Int) -> Int {
    if max_int(k1, k2) == 3 && max_int(c1, c2) >= 3 { 4 } else { max_int(k1, k2) }
}

public pure fn is_comp_adeq(f: AdeqTransFin, g: AdeqTransFin, fg: AdeqTransFin) -> Bool {
    fg.cost_slope == g.cost_slope * f.cost_slope
        && fg.cost_bias == g.cost_slope * f.cost_bias + g.cost_bias
        && fg.drift_pos == f.drift_pos + g.drift_pos
        && fg.drift_neg == f.drift_neg + g.drift_neg
        && fg.cls_rank == join_cls_pair(f.cls_rank, f.con_rank, g.cls_rank, g.con_rank)
        && fg.con_rank == join_con_pair(f.cls_rank, f.con_rank, g.cls_rank, g.con_rank)
}

public pure fn has_adeq_2cell(f: AdeqTransFin, g: AdeqTransFin) -> Bool {
    g.cost_slope <= f.cost_slope
        && g.cost_bias <= f.cost_bias
        && g.drift_pos <= f.drift_pos
        && g.drift_neg <= f.drift_neg
        && g.cls_rank <= f.cls_rank
        && g.con_rank <= f.con_rank
}

/// **Wave 3 Theorem 2 (Thm 4.7 & Thm 4.9 — Conical Non-Cancellation & No Opposite-Shift 2-Iso):**
/// Opposite Clock-Trap shifts F_+(1,0) and G_-(0,1) are strictly incomparable (no 2-iso),
/// while F_+ >> G_- cancels signed_shift == 0 yet preserves total_drift == 2, OpaqueAI, and (W2).
@verify(formal)
@framework(msfs, "Axis 4 Wave 3 — Conical Adeq2Cat Clock-Trap non-cancellation, no F_+ ~= F_-, and (W2)")
public theorem wave3_adeq2cat_conical_noncancellation_and_w2(
    f_plus: AdeqTransFin,
    g_minus: AdeqTransFin,
    fg: AdeqTransFin,
    f_cert: AdeqTransFin,
    h_ground: AdeqTransFin,
)
    requires valid_adeq_trans(f_plus) && f_plus.cost_slope == 1 && f_plus.cost_bias == 0
          && f_plus.drift_pos == 1 && f_plus.drift_neg == 0 && f_plus.cls_rank == 10 && f_plus.con_rank == 6
          && valid_adeq_trans(g_minus) && g_minus.cost_slope == 1 && g_minus.cost_bias == 0
          && g_minus.drift_pos == 0 && g_minus.drift_neg == 1 && g_minus.cls_rank == 1 && g_minus.con_rank == 1
          && is_comp_adeq(f_plus, g_minus, fg)
          && valid_adeq_trans(f_cert) && f_cert.cost_slope == 1 && f_cert.cost_bias == 0
          && f_cert.drift_pos == 0 && f_cert.drift_neg == 0 && f_cert.cls_rank == 0 && f_cert.con_rank == 0
          && valid_adeq_trans(h_ground) && total_drift(h_ground) == 0
    ensures !has_adeq_2cell(f_plus, g_minus)
         && !has_adeq_2cell(g_minus, f_plus)
         && signed_shift(fg) == 0
         && total_drift(fg) == 2
         && fg.cls_rank == 10 && fg.con_rank == 6
         && !has_adeq_2cell(h_ground, fg)
         && has_adeq_2cell(fg, f_cert)
         && !has_adeq_2cell(f_cert, fg)
    proof {
        have h_no_iso: !has_adeq_2cell(f_plus, g_minus) && !has_adeq_2cell(g_minus, f_plus) by omega;
        have h_shift: signed_shift(fg) == 0 && total_drift(fg) == 2 by omega;
        have h_tier: fg.cls_rank == 10 && fg.con_rank == 6 by omega;
        have h_no_in: !has_adeq_2cell(h_ground, fg) by omega;
        have h_w2: has_adeq_2cell(fg, f_cert) && !has_adeq_2cell(f_cert, fg) by omega;
        conclude by auto;
    };

/// 4-point finite specification model (`0` = False, `1` = True; strictly `Int` fields).
public type Fin4AdeqModel is {
    hf0: Int, hf1: Int, hf2: Int, hf3: Int,
    cf0: Int, cf1: Int, cf2: Int, cf3: Int,
    hr0: Int, hr1: Int, hr2: Int, hr3: Int,
    cr0: Int, cr1: Int, cr2: Int, cr3: Int,
};

public pure fn imp01(a: Int, b: Int) -> Bool { !(a == 1) || b == 1 }

public pure fn kernel_pass_4(m: Fin4AdeqModel) -> Bool {
    imp01(m.hf0, m.cf0) && imp01(m.hf1, m.cf1) && imp01(m.hf2, m.cf2) && imp01(m.hf3, m.cf3)
}

public pure fn c1_carrier_4(m: Fin4AdeqModel) -> Bool {
    m.hr0 == m.hf0 && m.hr1 == m.hf1 && m.hr2 == m.hf2 && m.hr3 == m.hf3
}

public pure fn c2_nonvac_4(m: Fin4AdeqModel) -> Bool {
    (m.hr0 == 1 && m.hf0 == 1 && m.cf0 == 1 && m.cr0 == 1)
        || (m.hr1 == 1 && m.hf1 == 1 && m.cf1 == 1 && m.cr1 == 1)
        || (m.hr2 == 1 && m.hf2 == 1 && m.cf2 == 1 && m.cr2 == 1)
        || (m.hr3 == 1 && m.hf3 == 1 && m.cf3 == 1 && m.cr3 == 1)
}

public pure fn c3_proxy_4(m: Fin4AdeqModel) -> Bool {
    imp01(m.cf0, m.cr0) && imp01(m.cf1, m.cr1) && imp01(m.cf2, m.cr2) && imp01(m.cf3, m.cr3)
}

public pure fn c4_adv_4(m: Fin4AdeqModel) -> Bool {
    (m.hf0 == 0 && m.cr0 == 0) || (m.hf1 == 0 && m.cr1 == 0)
        || (m.hf2 == 0 && m.cr2 == 0) || (m.hf3 == 0 && m.cr3 == 0)
}

public pure fn runtime_sound_4(m: Fin4AdeqModel) -> Bool {
    imp01(m.hr0, m.cr0) && imp01(m.hr1, m.cr1) && imp01(m.hr2, m.cr2) && imp01(m.hr3, m.cr3)
}

public pure fn runtime_nonvac_4(m: Fin4AdeqModel) -> Bool {
    (m.hr0 == 1 && m.cr0 == 1) || (m.hr1 == 1 && m.cr1 == 1)
        || (m.hr2 == 1 && m.cr2 == 1) || (m.hr3 == 1 && m.cr3 == 1)
}

public pure fn hyp_sensitive_4(m: Fin4AdeqModel) -> Bool {
    m.cr0 == 0 || m.cr1 == 0 || m.cr2 == 0 || m.cr3 == 0
}

public pure fn is_cm1(m: Fin4AdeqModel) -> Bool {
    m.hf0 == 1 && m.hf1 == 1 && m.hf2 == 0 && m.hf3 == 0
        && m.cf0 == 1 && m.cf1 == 1 && m.cf2 == 0 && m.cf3 == 0
        && m.hr0 == 0 && m.hr1 == 1 && m.hr2 == 1 && m.hr3 == 0
        && m.cr0 == 1 && m.cr1 == 1 && m.cr2 == 0 && m.cr3 == 0
}

public pure fn is_cm2(m: Fin4AdeqModel) -> Bool {
    m.hf0 == 0 && m.hf1 == 0 && m.hf2 == 0 && m.hf3 == 0
        && m.cf0 == 0 && m.cf1 == 0 && m.cf2 == 0 && m.cf3 == 0
        && m.hr0 == 0 && m.hr1 == 0 && m.hr2 == 0 && m.hr3 == 0
        && m.cr0 == 0 && m.cr1 == 0 && m.cr2 == 0 && m.cr3 == 0
}

public pure fn is_cm3(m: Fin4AdeqModel) -> Bool {
    m.hf0 == 0 && m.hf1 == 1 && m.hf2 == 0 && m.hf3 == 1
        && m.cf0 == 0 && m.cf1 == 1 && m.cf2 == 1 && m.cf3 == 1
        && m.hr0 == 0 && m.hr1 == 1 && m.hr2 == 0 && m.hr3 == 1
        && m.cr0 == 0 && m.cr1 == 0 && m.cr2 == 1 && m.cr3 == 1
}

public pure fn is_cm4(m: Fin4AdeqModel) -> Bool {
    m.hf0 == 0 && m.hf1 == 1 && m.hf2 == 0 && m.hf3 == 0
        && m.cf0 == 1 && m.cf1 == 1 && m.cf2 == 1 && m.cf3 == 1
        && m.hr0 == 0 && m.hr1 == 1 && m.hr2 == 0 && m.hr3 == 0
        && m.cr0 == 1 && m.cr1 == 1 && m.cr2 == 1 && m.cr3 == 1
}

/// **Wave 3 Theorem 3 (Thm 4.6 — CM-Adeq-1..4 Mutual Non-Redundancy):**
/// Universally checks Kernel=PASS, exact 4x4 off-diagonal independence matrix, and runtime failure.
@verify(formal)
@framework(msfs, "Axis 4 Wave 3 — CM-Adeq-1..4 strict mutual non-redundancy over Fin4AdeqModel")
public theorem wave3_cm_adeq_1_to_4_independence(
    m1: Fin4AdeqModel,
    m2: Fin4AdeqModel,
    m3: Fin4AdeqModel,
    m4: Fin4AdeqModel,
)
    requires is_cm1(m1) && is_cm2(m2) && is_cm3(m3) && is_cm4(m4)
    ensures kernel_pass_4(m1) && !c1_carrier_4(m1) && c2_nonvac_4(m1) && c3_proxy_4(m1) && c4_adv_4(m1) && !runtime_sound_4(m1)
         && kernel_pass_4(m2) && c1_carrier_4(m2) && !c2_nonvac_4(m2) && c3_proxy_4(m2) && c4_adv_4(m2) && !runtime_nonvac_4(m2)
         && kernel_pass_4(m3) && c1_carrier_4(m3) && c2_nonvac_4(m3) && !c3_proxy_4(m3) && c4_adv_4(m3) && !runtime_sound_4(m3)
         && kernel_pass_4(m4) && c1_carrier_4(m4) && c2_nonvac_4(m4) && c3_proxy_4(m4) && !c4_adv_4(m4) && !hyp_sensitive_4(m4)
    proof {
        have h_cm1: kernel_pass_4(m1) && !c1_carrier_4(m1) && c2_nonvac_4(m1) && c3_proxy_4(m1) && c4_adv_4(m1) && !runtime_sound_4(m1) by omega;
        have h_cm2: kernel_pass_4(m2) && c1_carrier_4(m2) && !c2_nonvac_4(m2) && c3_proxy_4(m2) && c4_adv_4(m2) && !runtime_nonvac_4(m2) by omega;
        have h_cm3: kernel_pass_4(m3) && c1_carrier_4(m3) && c2_nonvac_4(m3) && !c3_proxy_4(m3) && c4_adv_4(m3) && !runtime_sound_4(m3) by omega;
        have h_cm4: kernel_pass_4(m4) && c1_carrier_4(m4) && c2_nonvac_4(m4) && c3_proxy_4(m4) && !c4_adv_4(m4) && !hyp_sensitive_4(m4) by omega;
        conclude by auto;
    };

public type BudgetedEnv is {
    state_count: Int,
    obs_count: Int,
    budget: Int,
};

public pure fn valid_budgeted_env(e: BudgetedEnv) -> Bool {
    e.obs_count >= 1 && e.budget >= 0 && e.state_count == e.obs_count + e.budget
}

public pure fn act_cost_grade(n: Int, e: BudgetedEnv) -> Bool {
    n >= 0 && e.budget >= 0 && e.budget <= n
}

public pure fn same_reif_shadow(e1: BudgetedEnv, e2: BudgetedEnv) -> Bool {
    e1.obs_count == e2.obs_count
}

public pure fn is_act_iso(e1: BudgetedEnv, e2: BudgetedEnv) -> Bool {
    valid_budgeted_env(e1) && valid_budgeted_env(e2)
        && e1.obs_count == e2.obs_count && e1.budget == e2.budget && e1.state_count == e2.state_count
}

/// **Wave 3 Theorem 4 (Thm 4.3 — PVTerm.letBind DAG vs Tree ActCostGrade Gap):**
/// Concrete exponential separation at k = 4, 10, 14 (`4k+1` vs `2^(k+1)-1`) on Reif-equivalent BudgetedEnv.
@verify(formal)
@framework(msfs, "Axis 4 Wave 3 — PVTerm.letBind DAG vs tree-unfolding ActCostGrade separation")
public theorem wave3_letbind_dag_vs_tree_actcost_gap(
    k: Int,
    pow2_k1: Int,
    e_dag: BudgetedEnv,
    e_tree: BudgetedEnv,
)
    requires ((k == 4 && pow2_k1 == 32) || (k == 10 && pow2_k1 == 2048) || (k == 14 && pow2_k1 == 32768))
          && valid_budgeted_env(e_dag) && e_dag.obs_count == 2 && e_dag.budget == 4 * k + 1
          && valid_budgeted_env(e_tree) && e_tree.obs_count == 2 && e_tree.budget == pow2_k1 - 1
    ensures same_reif_shadow(e_dag, e_tree)
         && act_cost_grade(4 * k + 1, e_dag)
         && !act_cost_grade(4 * k + 1, e_tree)
         && !is_act_iso(e_dag, e_tree)
         && e_tree.budget - e_dag.budget >= 14
    proof {
        have h_shadow: same_reif_shadow(e_dag, e_tree) by auto;
        have h_dag: act_cost_grade(4 * k + 1, e_dag) by omega;
        have h_tree: !act_cost_grade(4 * k + 1, e_tree) by omega;
        have h_gap: !is_act_iso(e_dag, e_tree) && e_tree.budget - e_dag.budget >= 14 by omega;
        conclude by auto;
    };

public type PhpCrossoverWitness is {
    n_ips: Int,
    pow2_ips: Int,
    pow2_ips_prev: Int,
    n_ef: Int,
    pow2_ef: Int,
    pow2_ef_prev: Int,
};

public pure fn cube_int(x: Int) -> Int { x * x * x }
public pure fn pow4_int(x: Int) -> Int { x * x * x * x }

/// **Wave 3 Theorem 5 (Thm 4.2 — PHP_n^{n+1} Exact Crossover Witnesses):**
/// Exact crossovers for TreeRes vs IPS (`n = 19`) and TreeRes vs EF (`n = 28`) + reversals (`n = 18, 27`).
@verify(formal)
@framework(msfs, "Axis 4 Wave 3 — PHP_n^{n+1} exact exponential-vs-polynomial crossovers")
public theorem wave3_php_exact_crossovers(w: PhpCrossoverWitness)
    requires w.n_ips == 19 && w.pow2_ips == 524288 && w.pow2_ips_prev == 262144
          && w.n_ef == 28 && w.pow2_ef == 268435456 && w.pow2_ef_prev == 134217728
    ensures w.pow2_ips > 64 * cube_int(w.n_ips + 1)
         && w.pow2_ips_prev <= 64 * cube_int(w.n_ips)
         && w.pow2_ef > 256 * pow4_int(w.n_ef + 1)
         && w.pow2_ef_prev <= 256 * pow4_int(w.n_ef)
    proof {
        have h_ips: w.pow2_ips > 64 * cube_int(w.n_ips + 1) && w.pow2_ips_prev <= 64 * cube_int(w.n_ips) by omega;
        have h_ef: w.pow2_ef > 256 * pow4_int(w.n_ef + 1) && w.pow2_ef_prev <= 256 * pow4_int(w.n_ef) by omega;
        conclude by auto;
    };
