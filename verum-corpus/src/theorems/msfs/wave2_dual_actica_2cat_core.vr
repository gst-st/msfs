public pure fn is_cm_not_t_eps_hom(s: ActicaFiniteSig) -> Bool {
    has_base_actica_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.a_0 == 1 && s.a_1 == 1
