        && s.nu_alt == 0 && s.in_deg_alt == 1
}

// 13 distinct Dual Actica axiom predicates + `T-epsilon^{hom}`
public pure fn sat_a0(s: ActicaFiniteSig) -> Bool { s.ob_count >= 1 }
public pure fn sat_a1(s: ActicaFiniteSig) -> Bool {
    s.iota_0 >= 0 && s.iota_0 < s.ob_count
        && s.z2_zero != s.z2_one && s.iota_z2_0 != s.iota_z2_1 && s.iota_0 != s.iota_1
}
public pure fn sat_a2(s: ActicaFiniteSig) -> Bool { s.id_shift_0 == 0 && s.id_shift_1 == 0 && s.a_0 >= 0 }
public pure fn sat_a3(s: ActicaFiniteSig) -> Bool { s.anchor == 0 && s.anchor < s.ob_count }
public pure fn sat_a4(s: ActicaFiniteSig) -> Bool {
    s.act_00 == s.eval_rho_0_on_0 && s.act_01 == s.eval_rho_0_on_1
}
public pure fn sat_a5(s: ActicaFiniteSig) -> Bool {
    s.ob_count >= 2 && (s.rho_0 != s.rho_1 || s.rho_a0 != s.rho_0 || s.rho_a1 != s.rho_1)
}
public pure fn sat_a6(s: ActicaFiniteSig) -> Bool {
    s.ob_count >= 2 && (s.rho_a0 != s.rho_0 || s.rho_a1 != s.rho_1)
}
public pure fn sat_a7(s: ActicaFiniteSig) -> Bool {
    s.iota_0 >= 0 && s.iota_0 < s.ob_count
        && s.eval_rho_iota_a_on_rho0 == s.iota_rho_a0
        && s.eval_rho_iota_a_on_rho1 == s.iota_rho_a1
}
public pure fn sat_a8(s: ActicaFiniteSig) -> Bool {
    s.iter_a_0 == s.anchor && s.iter_a_1 > s.iter_a_0
        && s.iter_a_2 > s.iter_a_1 && s.co_orbit_cap < s.iter_a_2
}
public pure fn sat_a9(s: ActicaFiniteSig) -> Bool { s.conf_lo <= s.conf_hi }
public pure fn sat_t_eps(s: ActicaFiniteSig) -> Bool { s.gamma > s.anchor + s.act_vis_slack }
public pure fn sat_t2a_star(s: ActicaFiniteSig) -> Bool { s.comp_dp_bound < s.obj_depth }
public pure fn sat_t2a_star_star(s: ActicaFiniteSig) -> Bool {
    s.comp_dp_bound < s.obj_depth && s.comp_md_bound < s.obj_modal_cap
}
public pure fn sat_t_eps_hom(s: ActicaFiniteSig) -> Bool {
    s.nu_alt != s.nu_anchor || s.in_deg_alt == s.in_deg_anchor
}

public pure fn sat_all_13_act(s: ActicaFiniteSig) -> Bool {
    sat_a0(s) && sat_a1(s) && sat_a2(s) && sat_a3(s)
        && sat_a4(s) && sat_a5(s) && sat_a6(s) && sat_a7(s)
        && sat_a8(s) && sat_a9(s) && sat_t_eps(s)
        && sat_t2a_star(s) && sat_t2a_star_star(s)
}

/// **MSFS Wave 2 (Dual Actica 6 universal positive implications):**
/// For EVERY `s : ActicaFiniteSig`, proves `A-3 => A-0`, `A-1 => A-0`,
/// `A-5 => A-0`, `A-6 => A-5`, `A-7 => A-0`, and `T-2a** => T-2a*`.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B3 Dual Actica — 6 universal positive implications")
public theorem wave2_actica_six_positive_implications(s: ActicaFiniteSig)
    requires s.ob_count >= 0
    ensures (!sat_a3(s) || sat_a0(s))
         && (!sat_a1(s) || sat_a0(s))
         && (!sat_a5(s) || sat_a0(s))
         && (!sat_a6(s) || sat_a5(s))
         && (!sat_a7(s) || sat_a0(s))
         && (!sat_t2a_star_star(s) || sat_t2a_star(s))
    proof {
        have h_3_1_5: (!sat_a3(s) || sat_a0(s))
                   && (!sat_a1(s) || sat_a0(s))
                   && (!sat_a5(s) || sat_a0(s)) by omega;
        have h_6_7_t: (!sat_a6(s) || sat_a5(s))
                   && (!sat_a7(s) || sat_a0(s))
                   && (!sat_t2a_star_star(s) || sat_t2a_star(s)) by auto;
        conclude by auto;
    };

/// **MSFS Wave 2 (Dual Actica `ActShift2Cat_Z2` satisfies all 13 axioms + `T-epsilon^{hom}`):**
@verify(formal)
@framework(msfs, "MSFS Wave 2 B3 Dual Actica — ActShift2Cat_Z2 non-thin witness satisfies all 13 axioms")
public theorem wave2_actica_shift2cat_all_13(s: ActicaFiniteSig)
    requires is_act_shift2cat_z2(s)
    ensures sat_all_13_act(s) && sat_t_eps_hom(s) && s.z2_zero != s.z2_one
    proof {
        have h_0_to_4: sat_a0(s) && sat_a1(s) && sat_a2(s) && sat_a3(s) && sat_a4(s) by auto;
        have h_5_to_9: sat_a5(s) && sat_a6(s) && sat_a7(s) && sat_a8(s) && sat_a9(s) by auto;
        have h_t_and_nt: sat_t_eps(s) && sat_t2a_star(s) && sat_t2a_star_star(s)
                      && sat_t_eps_hom(s) && s.z2_zero != s.z2_one by auto;
        conclude by auto;
    };

/// **MSFS Wave 2 (Dual Actica 7+1 single-axiom separation countermodels):**
/// Verifies for each of the 7 single-axiom CMs (`CM_notA1`, `CM_notA6`, `CM_notA7`,
/// `CM_notA8`, `CM_notA9`, `CM_notTEps`, `CM_notT2aStarStar`) that ONLY its target
/// axiom fails while all 12 others hold, and for `CM_notTEpsHom` that ALL 13
/// axioms hold while `T-epsilon^{hom}` fails (`T-epsilon^{hom} </=> T-epsilon^{ex}`).
@verify(formal)
@framework(msfs, "MSFS Wave 2 B3 Dual Actica — 7+1 independence countermodels & T-epsilon^{hom} separation")
public theorem wave2_actica_seven_countermodels(
    c1: ActicaFiniteSig,
    c6: ActicaFiniteSig,
    c7: ActicaFiniteSig,
    c8: ActicaFiniteSig,
    c9: ActicaFiniteSig,
    ce: ActicaFiniteSig,
    ct: ActicaFiniteSig,
    ch: ActicaFiniteSig,
)
    requires is_cm_not_a1(c1)
          && is_cm_not_a6(c6)
          && is_cm_not_a7(c7)
          && is_cm_not_a8(c8)
          && is_cm_not_a9(c9)
          && is_cm_not_t_eps(ce)
          && is_cm_not_t2a_star_star(ct)
          && is_cm_not_t_eps_hom(ch)
    ensures (!sat_a1(c1) && sat_a0(c1) && sat_a2(c1) && sat_a3(c1) && sat_a4(c1)
             && sat_a5(c1) && sat_a6(c1) && sat_a7(c1) && sat_a8(c1) && sat_a9(c1)
             && sat_t_eps(c1) && sat_t2a_star(c1) && sat_t2a_star_star(c1))
         && (!sat_a6(c6) && sat_a0(c6) && sat_a1(c6) && sat_a2(c6) && sat_a3(c6)
             && sat_a4(c6) && sat_a5(c6) && sat_a7(c6) && sat_a8(c6) && sat_a9(c6)
             && sat_t_eps(c6) && sat_t2a_star(c6) && sat_t2a_star_star(c6))
         && (!sat_a7(c7) && sat_a0(c7) && sat_a1(c7) && sat_a2(c7) && sat_a3(c7)
             && sat_a4(c7) && sat_a5(c7) && sat_a6(c7) && sat_a8(c7) && sat_a9(c7)
             && sat_t_eps(c7) && sat_t2a_star(c7) && sat_t2a_star_star(c7))
         && (!sat_a8(c8) && sat_a0(c8) && sat_a1(c8) && sat_a2(c8) && sat_a3(c8)
             && sat_a4(c8) && sat_a5(c8) && sat_a6(c8) && sat_a7(c8) && sat_a9(c8)
             && sat_t_eps(c8) && sat_t2a_star(c8) && sat_t2a_star_star(c8))
         && (!sat_a9(c9) && sat_a0(c9) && sat_a1(c9) && sat_a2(c9) && sat_a3(c9)
             && sat_a4(c9) && sat_a5(c9) && sat_a6(c9) && sat_a7(c9) && sat_a8(c9)
             && sat_t_eps(c9) && sat_t2a_star(c9) && sat_t2a_star_star(c9))
         && (!sat_t_eps(ce) && sat_a0(ce) && sat_a1(ce) && sat_a2(ce) && sat_a3(ce)
             && sat_a4(ce) && sat_a5(ce) && sat_a6(ce) && sat_a7(ce) && sat_a8(ce)
             && sat_a9(ce) && sat_t2a_star(ce) && sat_t2a_star_star(ce) && sat_t_eps_hom(ce))
