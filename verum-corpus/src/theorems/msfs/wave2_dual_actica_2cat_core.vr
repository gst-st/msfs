/// Parameterized finite 2-categorical signature for the 13 repaired Dual Actica
/// conditions (`A-0..A-9`, `T-epsilon^{ex}`, `T-2a*`, `T-2a**`) plus `T-epsilon^{hom}`
/// rank & automorphism degree fields. Zero `: Bool` struct fields.
public type ActicaFiniteSig is {
    ob_count: Int,
    z2_zero: Int,
    z2_one: Int,
    iota_0: Int,
    iota_1: Int,
    iota_z2_0: Int,
    iota_z2_1: Int,
    id_shift_0: Int,
    id_shift_1: Int,
    a_0: Int,
    a_1: Int,
    anchor: Int,
    act_00: Int,
    act_01: Int,
    eval_rho_0_on_0: Int,
    eval_rho_0_on_1: Int,
    rho_0: Int,
    rho_1: Int,
    rho_a0: Int,
    rho_a1: Int,
    eval_rho_iota_a_on_rho0: Int,
    eval_rho_iota_a_on_rho1: Int,
    iota_rho_a0: Int,
    iota_rho_a1: Int,
    iter_a_0: Int,
    iter_a_1: Int,
    iter_a_2: Int,
    co_orbit_cap: Int,
    conf_lo: Int,
    conf_hi: Int,
    gamma: Int,
    act_vis_slack: Int,
    comp_dp_bound: Int,
    comp_md_bound: Int,
    obj_depth: Int,
    obj_modal_cap: Int,
    nu_anchor: Int,
    nu_alt: Int,
    in_deg_anchor: Int,
    in_deg_alt: Int,
};

public pure fn has_base_actica_fields(s: ActicaFiniteSig) -> Bool {
    s.ob_count >= 2
        && s.z2_zero == 0 && s.z2_one == 1
        && s.iota_0 == 0 && s.iota_1 == 1
        && s.id_shift_0 == 0 && s.id_shift_1 == 0
        && s.anchor == 0
        && s.obj_depth == 1 && s.obj_modal_cap == 1
        && s.nu_anchor == 0 && s.in_deg_anchor == 2
}

/// `ActShift2Cat_Z2` over `(Nat2CatZ2)^op`: `A(n) = n + 1`, `costep : A(0) -> 0`,
/// `rho_act(x) = x`, `act_act(x, y) = y + x`, `K_A^{act}` non-corepresentable.
public pure fn is_act_shift2cat_z2(s: ActicaFiniteSig) -> Bool {
    has_base_actica_fields(s)
        && s.iota_z2_0 == 0 && s.iota_z2_1 == 1
        && s.a_0 == 1 && s.a_1 == 1
        && s.act_00 == 0 && s.act_01 == 1
        && s.eval_rho_0_on_0 == 0 && s.eval_rho_0_on_1 == 1
        && s.rho_0 == 0 && s.rho_1 == 1 && s.rho_a0 == 1 && s.rho_a1 == 2
        && s.eval_rho_iota_a_on_rho0 == 1 && s.eval_rho_iota_a_on_rho1 == 2
        && s.iota_rho_a0 == 1 && s.iota_rho_a1 == 2
        && s.iter_a_0 == 0 && s.iter_a_1 == 1 && s.iter_a_2 == 2 && s.co_orbit_cap == 1
        && s.conf_lo == 0 && s.conf_hi == 1
        && s.gamma == 1 && s.act_vis_slack == 0
        && s.comp_dp_bound == 0 && s.comp_md_bound == 0
        && s.nu_alt == 1 && s.in_deg_alt == 2
}

