// =============================================================================
// STATUS: MACHINE-CHECKED WAVE 2 CONSTRUCTIVE CORE (ZERO AXIOMS)
// Self-contained finite constructive cores for MSFS Obligation B6 (`(Q3)`):
//   1. `wave2_q3_d3_strong_dialetheia_non_explosive`: Strongly dialetheic `D_3`
//      (`LP + sharp`) over `{0 = False, 1 = Both, 2 = True}` matching
//      `wave1_dual_enactment_core.vr`, proving universal contradiction validity
//      `gamma(v) /\ ~gamma(v)` and non-explosion (`!lp_designated(0)`).
//   2. `wave2_q3_d3_no_proper_subalgebra`: Every nonempty subset of `{0, 1, 2}`
//      closed under `~` and `sharp` equals `{0, 1, 2}`, and no Boolean
//      homomorphism `D_3 -> {0, 1}` exists.
//   3. `wave2_q3_bz2_lawvere_counterexample`: Closed SMC `B(Z_2)` refutes
//      Lawvere's diagonal fixed-point theorem, cartesian diagonal, terminal unit,
//      and monoidal forgetful embedding (`2 != 4`).
//   4. `wave2_q3_precedence_partition_sound`: 11-gate precedence tree `T_8`
//      across 14 verdict codes `0..13` is total, sound, mutually exclusive, and
//      resolves `(7) cap (4)` and `isDirect` non-classical routing.
// Imports zero `core.math.*` axioms and zero `: Bool` struct fields.
// =============================================================================

@arch_module(
    foundation: Foundation.ZfcTwoInacc,
    stratum: MsfsStratum.LFnd,
    lifecycle: Lifecycle.Theorem("v0.2"),
    cve_closure_C: "self",
    cve_closure_V_strategy: VerifyStrategy.Formal,
    cve_closure_E: "tests/test_wave2_proofs.py",
)
module lib.theorems.msfs.wave2_q3_witnesses;

// =============================================================================
// Part 1 & 2: Strongly Dialetheic `D_3 = LP + sharp` (`{0=False, 1=Both, 2=True}`)
// =============================================================================

public pure fn lp_designated(v: Int) -> Bool {
    v == 1 || v == 2
}

public pure fn lp_neg(v: Int) -> Int {
    2 - v
}

public pure fn lp_and(u: Int, v: Int) -> Int {
    if u == 0 || v == 0 { 0 }
    else if u == 1 || v == 1 { 1 }
    else { 2 }
}

public pure fn lp_or(u: Int, v: Int) -> Int {
    if u == 2 || v == 2 { 2 }
    else if u == 1 || v == 1 { 1 }
    else { 0 }
}

/// Dialetheic unary connective `sharp` for `(B-Q3.2)`:
/// `sharp(0) = 1`, `sharp(2) = 1`, `sharp(1) = 0`.
public pure fn lp_sharp(v: Int) -> Int {
    if v == 1 { 0 } else { 1 }
}

/// `gamma(v) := sharp(v) \/ sharp(sharp(v))`.
public pure fn d3_gamma(v: Int) -> Int {
    lp_or(lp_sharp(v), lp_sharp(lp_sharp(v)))
}

/// **MSFS Wave 2 (`(B-Q3.2)` Strongly Dialetheic `D_3` Non-Explosion):**
/// For every valuation `v in {0, 1, 2}`, `gamma(v) /\ ~gamma(v)` evaluates to `1`
/// (designated), while `0` is undesignated (`!lp_designated(0)`), contrasting
/// pure-LP classical valuations `v_cl in {0, 2}` where `v_cl /\ ~v_cl` fails.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B6 — (B-Q3.2) D_3 universal contradiction validity and non-explosion")
public theorem wave2_q3_d3_strong_dialetheia_non_explosive(v: Int, v_cl: Int)
    requires 0 <= v && v <= 2 && (v_cl == 0 || v_cl == 2)
    ensures d3_gamma(v) == 1
         && lp_and(d3_gamma(v), lp_neg(d3_gamma(v))) == 1
         && lp_designated(lp_and(d3_gamma(v), lp_neg(d3_gamma(v))))
         && !lp_designated(0)
         && !lp_designated(lp_and(v_cl, lp_neg(v_cl)))
    proof {
        have h_gamma: d3_gamma(v) == 1 by auto;
        have h_contra: lp_and(d3_gamma(v), lp_neg(d3_gamma(v))) == 1
                    && lp_designated(lp_and(d3_gamma(v), lp_neg(d3_gamma(v)))) by auto;
        have h_sep: !lp_designated(0) && !lp_designated(lp_and(v_cl, lp_neg(v_cl))) by auto;
        conclude by auto;
    };

/// Subset of `{0, 1, 2}` encoded as `{0, 1}`-valued `Int` indicators.
public type Subalg3 is {
    has_0: Int,
    has_1: Int,
    has_2: Int,
};

public pure fn valid_sub3(s: Subalg3) -> Bool {
    (s.has_0 == 0 || s.has_0 == 1)
        && (s.has_1 == 0 || s.has_1 == 1)
        && (s.has_2 == 0 || s.has_2 == 1)
}

public pure fn nonempty_sub3(s: Subalg3) -> Bool {
    s.has_0 == 1 || s.has_1 == 1 || s.has_2 == 1
}

public pure fn sub3_has(s: Subalg3, v: Int) -> Bool {
    if v == 0 { s.has_0 == 1 } else if v == 1 { s.has_1 == 1 } else { s.has_2 == 1 }
}

public pure fn closed_neg_sub3(s: Subalg3) -> Bool {
    (!sub3_has(s, 0) || sub3_has(s, lp_neg(0)))
        && (!sub3_has(s, 1) || sub3_has(s, lp_neg(1)))
        && (!sub3_has(s, 2) || sub3_has(s, lp_neg(2)))
}

public pure fn closed_sharp_sub3(s: Subalg3) -> Bool {
    (!sub3_has(s, 0) || sub3_has(s, lp_sharp(0)))
        && (!sub3_has(s, 1) || sub3_has(s, lp_sharp(1)))
        && (!sub3_has(s, 2) || sub3_has(s, lp_sharp(2)))
}

public pure fn is_bool_neg_hom(h0: Int, h1: Int, h2: Int) -> Bool {
    h0 == 1 - h2 && h1 == 1 - h1 && h2 == 1 - h0
}

/// **MSFS Wave 2 (`(B-Q3.2)` No Proper Subalgebra & No Boolean Homomorphism):**
/// Every nonempty subset of `D_3 = {0, 1, 2}` closed under `~` and `sharp`
/// contains all three elements, and no Boolean homomorphism `D_3 -> {0, 1}` exists.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B6 — (B-Q3.2) D_3 has no proper subalgebra and no Boolean hom")
public theorem wave2_q3_d3_no_proper_subalgebra(
    s: Subalg3,
    h0: Int,
    h1: Int,
    h2: Int,
)
    requires valid_sub3(s)
          && nonempty_sub3(s)
          && closed_neg_sub3(s)
          && closed_sharp_sub3(s)
          && (h0 == 0 || h0 == 1)
          && (h1 == 0 || h1 == 1)
          && (h2 == 0 || h2 == 1)
    ensures s.has_0 == 1
         && s.has_1 == 1
         && s.has_2 == 1
         && !is_bool_neg_hom(h0, h1, h2)
    proof {
        have h_full: s.has_0 == 1 && s.has_1 == 1 && s.has_2 == 1 by omega;
        have h_nohom: !is_bool_neg_hom(h0, h1, h2) by omega;
        conclude by auto;
    };

// =============================================================================
// Part 3: Closed Symmetric Monoidal Category `B(Z_2)` Refuting Lawvere (`(B-Q3.4)`)
// =============================================================================

public pure fn bz2_comp(g: Int, f: Int) -> Int {
    (f + g) % 2
}

public pure fn bz2_tensor(f: Int, g: Int) -> Int {
    (f + g) % 2
}

public pure fn bz2_eval(unit_ob: Int) -> Int {
    if unit_ob == 0 { 0 } else { 0 }
}

public pure fn bz2_curry(g: Int) -> Int { g }

public pure fn bz2_natural_diag(d: Int, a: Int) -> Bool {
    bz2_comp(d, bz2_tensor(a, a)) == bz2_comp(a, d)
}

/// **MSFS Wave 2 (`(B-Q3.4)` Closed SMC `B(Z_2)` Refutes Lawvere & Product Embedding):**
/// `B(Z_2)` satisfies closed SMC laws (`eval o (curry(g) (x) id) = g`), yet
/// `Hom(*, *)` is non-terminal (`0 != 1`), `U(* (x) *) = 2 != 4 = U(*) x U(*)`,
/// no cartesian diagonal exists (`d in {0, 1}` fails at `a = 1`), `e = 0` is
/// point-surjective, and `f = 1` has no fixed point.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B6 — (B-Q3.4) B(Z_2) closed SMC refutes Lawvere diagonal and cartesian structure")
public theorem wave2_q3_bz2_lawvere_counterexample(
    f: Int,
    g: Int,
    h: Int,
    a: Int,
    d: Int,
    p: Int,
    y: Int,
)
    requires (f == 0 || f == 1)
          && (g == 0 || g == 1)
          && (h == 0 || h == 1)
          && (a == 0 || a == 1)
          && (d == 0 || d == 1)
          && (p == 0 || p == 1)
          && (y == 0 || y == 1)
    ensures bz2_comp(h, bz2_comp(g, f)) == bz2_comp(bz2_comp(h, g), f)
         && bz2_comp(bz2_tensor(g, h), bz2_tensor(f, a)) == bz2_tensor(bz2_comp(g, f), bz2_comp(h, a))
         && bz2_comp(bz2_eval(0), bz2_tensor(bz2_curry(g), 0)) == g
         && 0 != 1
         && 2 != 2 * 2
         && !bz2_natural_diag(d, 1)
         && bz2_comp(0, p) == p
         && bz2_comp(1, y) != y
    proof {
        have h_smc: bz2_comp(h, bz2_comp(g, f)) == bz2_comp(bz2_comp(h, g), f)
                 && bz2_comp(bz2_tensor(g, h), bz2_tensor(f, a)) == bz2_tensor(bz2_comp(g, f), bz2_comp(h, a))
                 && bz2_comp(bz2_eval(0), bz2_tensor(bz2_curry(g), 0)) == g by omega;
        have h_nodiag: 0 != 1 && 2 != 2 * 2 && !bz2_natural_diag(d, 1) by omega;
        have h_lawvere: bz2_comp(0, p) == p && bz2_comp(1, y) != y by omega;
        conclude by auto;
    };

// =============================================================================
// Part 4: 11-Gate Precedence Decision Tree `T_8` (`Q3-Partition`, Codes `0..13`)
// =============================================================================

/// `(R3)`-consistent profile over 19 `{0, 1}`-valued `Int` fields (zero `: Bool`
/// struct fields). Codes `0..13`: `0=c1, 1=c2, 2=c3, 3=c4, 4=c5, 5=c6, 6=c7,
/// 7=c8a, 8=c8b, 9=bq31, 10=bq32, 11=bq33, 12=bq34, 13=bq35`.
public type Q3Profile is {
    has_r1: Int,
    has_r2: Int,
    has_r5a: Int,
    is_lawvere: Int,
    has_lawvere_emb: Int,
    is_paraconsistent: Int,
    has_classical_kernel: Int,
    is_gluing: Int,
    is_int_slice: Int,
    is_modal_acyclic: Int,
    is_refl_tower: Int,
    has_ord_not: Int,
    is_univ_poly: Int,
    has_r5a_limit: Int,
    is_non_classical: Int,
    has_neg_trans: Int,
    is_slice_cons: Int,
    has_diag_ab: Int,
    is_direct: Int,
};

public pure fn is_01(x: Int) -> Bool { x == 0 || x == 1 }

public pure fn valid_q3_profile(p: Q3Profile) -> Bool {
    is_01(p.has_r1) && is_01(p.has_r2) && is_01(p.has_r5a)
        && is_01(p.is_lawvere) && is_01(p.has_lawvere_emb)
        && is_01(p.is_paraconsistent) && is_01(p.has_classical_kernel)
        && is_01(p.is_gluing) && is_01(p.is_int_slice) && is_01(p.is_modal_acyclic)
        && is_01(p.is_refl_tower) && is_01(p.has_ord_not)
        && is_01(p.is_univ_poly) && is_01(p.has_r5a_limit)
        && is_01(p.is_non_classical) && is_01(p.has_neg_trans)
        && is_01(p.is_slice_cons) && is_01(p.has_diag_ab) && is_01(p.is_direct)
}

public pure fn pass_g1(p: Q3Profile) -> Bool { p.has_r1 == 1 }
public pure fn pass_g2(p: Q3Profile) -> Bool { pass_g1(p) && p.has_r2 == 1 && p.has_r5a == 1 }
public pure fn pass_g3(p: Q3Profile) -> Bool { pass_g2(p) && (p.is_lawvere == 1 || p.has_lawvere_emb == 1) }
public pure fn pass_g4(p: Q3Profile) -> Bool { pass_g3(p) && p.is_paraconsistent == 0 }
public pure fn pass_g5(p: Q3Profile) -> Bool { pass_g4(p) && p.is_gluing == 0 }
public pure fn pass_g6(p: Q3Profile) -> Bool { pass_g5(p) && p.is_int_slice == 0 }
public pure fn pass_g7(p: Q3Profile) -> Bool { pass_g6(p) && p.is_modal_acyclic == 0 }
public pure fn pass_g8(p: Q3Profile) -> Bool { pass_g7(p) && p.is_refl_tower == 0 }
public pure fn pass_g9(p: Q3Profile) -> Bool { pass_g8(p) && p.is_univ_poly == 0 }

public pure fn blocked_g10(p: Q3Profile) -> Bool {
    p.is_direct == 1 || p.is_slice_cons == 1 || (p.has_neg_trans == 1 && p.has_diag_ab == 1)
}

public pure fn blocked_g11(p: Q3Profile) -> Bool {
    p.is_direct == 1 || p.is_slice_cons == 1 || p.has_diag_ab == 1
}

public pure fn classify_q3(p: Q3Profile) -> Int {
    if p.has_r1 == 0 { 5 }
    else if p.has_r2 == 0 || p.has_r5a == 0 { 9 }
    else if p.is_lawvere == 0 && p.has_lawvere_emb == 0 { 12 }
    else if p.is_paraconsistent == 1 {
        if p.has_classical_kernel == 1 { 8 } else { 10 }
    }
    else if p.is_gluing == 1 { 6 }
    else if p.is_int_slice == 1 { 3 }
    else if p.is_modal_acyclic == 1 { 4 }
    else if p.is_refl_tower == 1 {
        if p.has_ord_not == 1 { 2 } else { 11 }
    }
    else if p.is_univ_poly == 1 {
        if p.has_r5a_limit == 1 { 1 } else { 11 }
    }
    else if p.is_non_classical == 1 {
        if blocked_g10(p) { 7 } else { 13 }
    }
    else {
        if blocked_g11(p) { 0 } else { 13 }
    }
}

public pure fn in_t8_code(p: Q3Profile, code: Int) -> Bool {
    if code == 5 { !pass_g1(p) }
    else if code == 9 { pass_g1(p) && !pass_g2(p) }
    else if code == 12 { pass_g2(p) && !pass_g3(p) }
    else if code == 8 { pass_g3(p) && p.is_paraconsistent == 1 && p.has_classical_kernel == 1 }
    else if code == 10 { pass_g3(p) && p.is_paraconsistent == 1 && p.has_classical_kernel == 0 }
    else if code == 6 { pass_g4(p) && p.is_gluing == 1 }
    else if code == 3 { pass_g5(p) && p.is_int_slice == 1 }
    else if code == 4 { pass_g6(p) && p.is_modal_acyclic == 1 }
    else if code == 2 { pass_g7(p) && p.is_refl_tower == 1 && p.has_ord_not == 1 }
    else if code == 1 { pass_g8(p) && p.is_univ_poly == 1 && p.has_r5a_limit == 1 }
    else if code == 11 {
        (pass_g7(p) && p.is_refl_tower == 1 && p.has_ord_not == 0)
            || (pass_g8(p) && p.is_univ_poly == 1 && p.has_r5a_limit == 0)
    }
    else if code == 7 { pass_g9(p) && p.is_non_classical == 1 && blocked_g10(p) }
    else if code == 0 { pass_g9(p) && p.is_non_classical == 0 && blocked_g11(p) }
    else if code == 13 {
        (pass_g9(p) && p.is_non_classical == 1 && !blocked_g10(p))
            || (pass_g9(p) && p.is_non_classical == 0 && !blocked_g11(p))
    }
    else { false }
}

public pure fn is_stc_overlap_profile(p: Q3Profile) -> Bool {
    valid_q3_profile(p)
        && pass_g4(p)
        && p.is_gluing == 1
        && p.is_int_slice == 1
        && p.is_non_classical == 1
        && p.has_neg_trans == 0
        && p.is_slice_cons == 0
        && p.has_diag_ab == 0
}

public pure fn is_direct_nc_profile(p: Q3Profile) -> Bool {
    valid_q3_profile(p)
        && pass_g9(p)
        && p.is_non_classical == 1
        && p.is_direct == 1
        && p.is_slice_cons == 0
        && p.has_neg_trans == 0
}

/// **MSFS Wave 2 (`Q3-Partition` `T_8` Totality, Mutual Exclusion & Precedence):**
/// Every valid `(R3)`-consistent profile `p` maps to a unique verdict code
/// `c in 0..13` (`in_t8_code(p, c)` holds, and `!in_t8_code(p, c_other)` for any
/// `c_other != c`), `STC` gluing+slice overlap resolves to `c7` (`6`), and direct
/// non-classical profiles without `neg_trans` resolve to `c8a` (`7`), never `bq35`.
@verify(formal)
@framework(msfs, "MSFS Wave 2 B6 — T_8 precedence decision tree totality, mutual exclusion, and edge routing")
public theorem wave2_q3_precedence_partition_sound(
    p: Q3Profile,
    c_other: Int,
    p_stc: Q3Profile,
    p_dir: Q3Profile,
)
    requires valid_q3_profile(p)
          && 0 <= c_other && c_other <= 13
          && c_other != classify_q3(p)
          && is_stc_overlap_profile(p_stc)
          && is_direct_nc_profile(p_dir)
    ensures 0 <= classify_q3(p) && classify_q3(p) <= 13
         && in_t8_code(p, classify_q3(p))
         && !in_t8_code(p, c_other)
         && classify_q3(p_stc) == 6
         && classify_q3(p_dir) == 7
    proof {
        have h_total: 0 <= classify_q3(p) && classify_q3(p) <= 13
                   && in_t8_code(p, classify_q3(p)) by auto;
        have h_excl: !in_t8_code(p, c_other) by auto;
        have h_edge: classify_q3(p_stc) == 6 && classify_q3(p_dir) == 7 by auto;
        conclude by auto;
    };
